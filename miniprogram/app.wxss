/* ═══════════════════════════════════════════
   全局样式 — iOS 亮色主题 v3.0
   底 F2F2F7 / 卡 FFFFFF / 系统色 / SF 字体
   ═══════════════════════════════════════════ */

page {
  background: #F2F2F7;
  color: #1C1C1E;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  min-height: 100vh;
}

view, text, scroll-view {
  box-sizing: border-box;
}

.scroll-page {
  padding: 16rpx 16rpx 140rpx;
}

/* ── 卡片 ── */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 1rpx 10rpx rgba(0,0,0,0.05), 0 2rpx 20rpx rgba(0,0,0,0.03);
}

.card-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #8E8E93;
  letter-spacing: 1rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.card-title-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #8E8E93;
  letter-spacing: 1rpx;
}

/* ── 状态行 ── */
.stat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}
.stat-row + .stat-row {
  border-top: 1rpx solid rgba(60,60,67,0.08);
}
.stat-label {
  color: #8E8E93;
  font-size: 26rpx;
}
.stat-value {
  font-size: 28rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

/* ── 颜色 — iOS 系统色 ── */
.text-green  { color: #34C759; }
.text-red    { color: #FF3B30; }
.text-orange { color: #FF9500; }
.text-blue   { color: #007AFF; }
.text-gray   { color: #8E8E93; }
.text-dark   { color: #1C1C1E; }

/* ── 标签 ── */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 600;
  white-space: nowrap;
  flex-shrink: 0;
}
.badge-green  { background: rgba(52,199,89,0.12);  color: #34C759; }
.badge-red    { background: rgba(255,59,48,0.12);  color: #FF3B30; }
.badge-orange { background: rgba(255,149,0,0.12);  color: #FF9500; }
.badge-blue   { background: rgba(0,122,255,0.12);  color: #007AFF; }
.badge-gray   { background: rgba(142,142,147,0.12); color: #8E8E93; }

/* ── 指示灯 ── */
.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  display: inline-block;
  flex-shrink: 0;
}
.dot-green  { background: #34C759; }
.dot-red    { background: #FF3B30; }
.dot-orange { background: #FF9500; }
.dot-gray   { background: #C7C7CC; }
.dot-blue   { background: #007AFF; }

/* ── 进度条 ── */
.progress-bar {
  height: 8rpx;
  background: #F2F2F7;
  border-radius: 4rpx;
  overflow: hidden;
  max-width: 100%;
}
.progress-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.4s ease;
}
.progress-green  { background: #34C759; }
.progress-red    { background: #FF3B30; }
.progress-blue   { background: #007AFF; }

/* ── 统计数字卡片网格 ── */
.stats-grid {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}
.stat-cell {
  flex: 1;
  min-width: 0;
  padding: 12rpx 4rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.stat-cell-value {
  font-size: 40rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.5rpx;
  line-height: 1.2;
  margin-bottom: 4rpx;
  text-align: center;
  width: 100%;
}
.stat-cell-label {
  font-size: 22rpx;
  color: #8E8E93;
  font-weight: 500;
  line-height: 1.2;
  text-align: center;
  width: 100%;
}

/* ── 空状态 ── */
.empty-state {
  text-align: center;
  padding: 48rpx 0;
  color: #C7C7CC;
  font-size: 26rpx;
}

/* ── 连接状态条 ── */
.conn-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  font-weight: 500;
}
.conn-ok  { background: rgba(52,199,89,0.08);  color: #248A3D; }
.conn-off { background: rgba(142,142,147,0.08); color: #8E8E93; }

/* ── 节点行 ── */
.node-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  gap: 12rpx;
}
.node-row + .node-row {
  border-top: 1rpx solid rgba(60,60,67,0.06);
}
.node-label {
  font-size: 26rpx;
  color: #1C1C1E;
  flex: 1;
  min-width: 0;
}
.node-status {
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}

/* ── 按钮 ── */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 22rpx 48rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  letter-spacing: 1rpx;
}
.btn-primary { background: #007AFF; color: #FFFFFF; }
.btn-warning { background: rgba(255,149,0,0.10); color: #FF9500; }
.btn-danger  { background: rgba(255,59,48,0.10); color: #FF3B30; }
.btn:active  { opacity: 0.6; transform: scale(0.97); }

/* ── 大数字 ── */
.big-number {
  font-size: 56rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  letter-spacing: -1rpx;
}
