<scroll-view class="scroll-page" scroll-y>

  <!-- 总览 -->
  <view class="card">
    <text class="card-title">归因总览</text>
    <view class="stats-grid">
      <view class="stat-cell">
        <text class="stat-cell-value text-dark">{{nFactors}}</text>
        <text class="stat-cell-label">因子数</text>
      </view>
      <view class="stat-cell">
        <text class="stat-cell-value text-dark">{{totalTrades}}</text>
        <text class="stat-cell-label">归因交易</text>
      </view>
      <view class="stat-cell">
        <text class="stat-cell-value {{winRateCls}}">{{winRate}}</text>
        <text class="stat-cell-label">胜率</text>
      </view>
      <view class="stat-cell">
        <text class="stat-cell-value {{sharpeCls}}">{{sharpe}}</text>
        <text class="stat-cell-label">Sharpe</text>
      </view>
    </view>
  </view>

  <!-- 因子贡献排名 -->
  <view class="card">
    <text class="card-title">因子贡献 (avg_mc)</text>
    <block wx:if="{{factors.length}}">
      <view wx:for="{{factors}}" wx:key="name" class="stat-row">
        <view style="display:flex;align-items:center;gap:12rpx;flex:1;min-width:0">
          <text style="font-size:22rpx;color:#C7C7CC;font-weight:600;width:36rpx">#{{index+1}}</text>
          <text style="font-size:26rpx;color:#1C1C1E;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{item.label}}</text>
          <text class="badge {{item.wrBadge}}" style="font-size:18rpx">{{item.wrText}}</text>
        </view>
        <text class="stat-value {{item.mcCls}}" style="font-size:24rpx">{{item.mcText}}</text>
      </view>
    </block>
    <view wx:else class="empty-state"><text>暂无归因数据</text></view>
  </view>

  <!-- 权重 -->
  <view class="card">
    <text class="card-title">因子权重 Top 20</text>
    <block wx:if="{{weights.length}}">
      <view wx:for="{{weights}}" wx:key="factor" class="stat-row" style="padding:12rpx 0">
        <view style="flex:1;min-width:0">
          <text style="font-size:26rpx;color:#1C1C1E">{{item.factor}}</text>
          <view class="progress-bar" style="margin-top:8rpx;height:6rpx;max-width:240rpx">
            <view class="progress-fill progress-blue" style="width:{{item.barPct}}%"></view>
          </view>
        </view>
        <text class="stat-value" style="font-size:26rpx">{{item.weight}}</text>
      </view>
    </block>
    <view wx:else class="empty-state"><text>暂无权重数据</text></view>
  </view>

  <view style="text-align:center;padding:16rpx;color:#C7C7CC;font-size:22rpx">
    每 30 秒刷新 · {{updated}}
  </view>

</scroll-view>
