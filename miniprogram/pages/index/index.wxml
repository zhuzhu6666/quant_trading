<scroll-view class="scroll-page" scroll-y>

  <!-- 连接状态 -->
  <view class="conn-bar {{connected ? 'conn-ok' : 'conn-off'}}">
    <text class="dot {{connected ? 'dot-green' : 'dot-gray'}}"></text>
    <text>{{connLabel}}</text>
    <text style="margin-left:auto;font-size:22rpx;color:#8E8E93">{{lastUpdate}}</text>
  </view>

  <!-- 管道状态卡 -->
  <view class="card">
    <view style="display:flex;align-items:center;gap:16rpx">
      <view style="width:80rpx;height:80rpx;border-radius:40rpx;display:flex;align-items:center;justify-content:center;background:{{pipelineRunning ? 'rgba(52,199,89,0.10)' : 'rgba(142,142,147,0.10)'}}">
        <text style="font-size:44rpx">{{pipelineRunning ? '⚡' : '⏸'}}</text>
      </view>
      <view style="flex:1">
        <text style="font-size:36rpx;font-weight:700;color:#1C1C1E;display:block">{{pipelineRunning ? '管道运行中' : '管道已停止'}}</text>
        <text style="font-size:24rpx;color:#8E8E93" wx:if="{{runningCount > 0}}">{{runningCount}}/9 节点正常</text>
      </view>
      <text class="badge {{pipelineBadge}}" style="font-size:24rpx;padding:6rpx 18rpx">{{pipelineLabel}}</text>
    </view>

    <!-- 控制按钮 -->
    <view style="display:flex;gap:16rpx;margin-top:24rpx">
      <view class="btn btn-primary" style="flex:1;opacity:{{pipelineRunning ? 0.4 : 1}}"
        bindtap="startPipeline">
        {{pipelineRunning ? '运行中' : '▶ 启动'}}
      </view>
      <view class="btn btn-warning" style="flex:1;opacity:{{restarting ? 0.4 : 1}}"
        bindtap="restartPipeline">
        {{restarting ? '重启中...' : '↻ 重启'}}
      </view>
      <view class="btn btn-danger" style="flex:1;opacity:{{pipelineRunning ? 1 : 0.4}}"
        bindtap="stopPipeline">
        {{pipelineRunning ? '⏹ 停止' : '已停止'}}
      </view>
    </view>

    <view wx:if="{{controlMsg}}" style="margin-top:16rpx;padding:12rpx;border-radius:14rpx;text-align:center;background:{{controlOk ? 'rgba(52,199,89,0.08)' : controlErr ? 'rgba(255,59,48,0.08)' : '#F2F2F7'}}">
      <text style="font-size:22rpx;font-weight:500;color:{{controlOk ? '#34C759' : controlErr ? '#FF3B30' : '#8E8E93'}}">
        {{controlMsg}}
      </text>
    </view>
  </view>

  <!-- 管道节点 -->
  <view class="card">
    <view style="display:flex;justify-content:space-between;align-items:center;margin-bottom:{{expanded ? '16rpx' : '0'}}"
      bindtap="toggleExpand">
      <text class="card-title-text">管道节点</text>
      <text style="font-size:24rpx;color:#8E8E93">{{expanded ? '收起 ▲' : '展开 ▼'}}</text>
    </view>

    <view wx:if="{{expanded}}">
      <view wx:for="{{nodes}}" wx:key="label" class="node-row">
        <text class="dot {{item.dot}}"></text>
        <text class="node-label">{{item.label}}</text>
        <text class="node-status {{item.statusCls}}">{{item.statusText}}</text>
      </view>
    </view>
    <view wx:else style="padding:8rpx 0">
      <text style="font-size:24rpx;color:#8E8E93">{{runningCount}}/9 运行中</text>
    </view>
  </view>

</scroll-view>
