<view class="login-page">
  <view class="login-card">
    <text class="login-title">XAUUSD 量化监控</text>
    <text class="login-sub">请输入交易账户密码</text>

    <input class="login-input" type="text" placeholder="用户名"
      value="{{username}}" bindinput="onUsernameInput"/>
    <input class="login-input" type="password" placeholder="密码"
      value="{{password}}" bindinput="onPasswordInput"/>

    <view class="btn btn-primary" style="width:100%;margin-top:32rpx"
      bindtap="doLogin">
      {{loading ? '登录中...' : '登录'}}
    </view>

    <text wx:if="{{error}}" class="login-error">{{error}}</text>
  </view>
</view>
