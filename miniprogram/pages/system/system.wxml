<scroll-view class="scroll-page" scroll-y>

  <!-- v5: 服务器健康 -->
  <view class="card">
    <text class="card-title">服务器</text>
    <view class="stats-grid" style="margin-bottom:16rpx">
      <view class="stat-cell">
        <text class="stat-cell-value {{serverStatusCls}}" style="font-size:32rpx">{{serverStatus}}</text>
        <text class="stat-cell-label">状态</text>
      </view>
      <view class="stat-cell">
        <text class="stat-cell-value text-dark" style="font-size:32rpx">{{serverUptime}}</text>
        <text class="stat-cell-label">运行时间</text>
      </view>
      <view class="stat-cell">
        <text class="stat-cell-value text-dark" style="font-size:32rpx">{{serverDb}}</text>
        <text class="stat-cell-label">数据库</text>
      </view>
    </view>
    <view class="stat-row">
      <text class="stat-label">地址</text>
      <text class="stat-value" style="font-size:24rpx;color:#8E8E93">{{server}}</text>
    </view>
    <view class="stat-row">
      <text class="stat-label">数据源</text>
      <text class="stat-value text-green" style="font-size:24rpx">cTrader</text>
    </view>
    <view class="stat-row" style="border:none">
      <text class="stat-label">版本</text>
      <text class="stat-value" style="font-size:24rpx;color:#8E8E93">Factor Takeover v5</text>
    </view>
  </view>

  <!-- 数据库健康 -->
  <view class="card">
    <text class="card-title">数据库健康</text>
    <view style="display:flex;align-items:center;gap:12rpx;margin-bottom:16rpx">
      <text class="dot {{dbOverall === '健康' ? 'dot-green' : dbOverall === '降级' ? 'dot-orange' : 'dot-red'}}"></text>
      <text style="font-size:28rpx;font-weight:700;color:#1C1C1E">{{dbOverall}}</text>
      <text style="font-size:22rpx;color:#8E8E93;margin-left:auto">{{dbSummary}}</text>
    </view>

    <block wx:if="{{dbList.length}}">
      <view wx:for="{{dbList}}" wx:key="file" class="stat-row" style="padding:14rpx 0">
        <view style="flex:1;min-width:0">
          <view style="display:flex;align-items:center;gap:10rpx">
            <text class="dot {{item.freshnessDot}}"></text>
            <text style="font-size:26rpx;font-weight:600;color:#1C1C1E">{{item.name}}</text>
          </view>
          <view style="display:flex;gap:20rpx;margin-top:6rpx;margin-left:24rpx">
            <text style="font-size:22rpx;color:#8E8E93">{{item.size}}</text>
            <text style="font-size:22rpx;color:#8E8E93">{{item.rows}} 行</text>
            <text style="font-size:22rpx;color:#C7C7CC">{{item.ageText}}</text>
          </view>
          <text wx:if="{{item.hasError}}" style="font-size:20rpx;color:#FF3B30;margin-top:4rpx;margin-left:24rpx">⚠ 查询异常</text>
        </view>
        <text class="badge {{item.freshness === '实时' ? 'badge-green' : item.freshness === '正常' ? 'badge-green' : item.freshness === '延迟' ? 'badge-orange' : 'badge-gray'}}" style="font-size:20rpx;flex-shrink:0">{{item.freshness}}</text>
      </view>
    </block>
    <view wx:else class="empty-state"><text>暂无数据库信息</text></view>

    <view wx:if="{{dbCheckedAt}}" style="text-align:right;margin-top:12rpx">
      <text style="font-size:20rpx;color:#C7C7CC">检查时间 {{dbCheckedAt}}</text>
    </view>
  </view>

  <!-- 因子健康 (v5) -->
  <view class="card" wx:if="{{factorHealth.hasData}}">
    <text class="card-title">因子健康</text>
    <view class="stats-grid" style="margin-bottom:16rpx">
      <view class="stat-cell">
        <text class="stat-cell-value text-dark" style="font-size:32rpx">{{factorHealth.total}}</text>
        <text class="stat-cell-label">总数</text>
      </view>
      <view class="stat-cell">
        <text class="stat-cell-value text-green" style="font-size:32rpx">{{factorHealth.healthy}}</text>
        <text class="stat-cell-label">健康</text>
      </view>
      <view class="stat-cell">
        <text class="stat-cell-value text-orange" style="font-size:32rpx">{{factorHealth.watch}}</text>
        <text class="stat-cell-label">观察</text>
      </view>
      <view class="stat-cell">
        <text class="stat-cell-value text-red" style="font-size:32rpx">{{factorHealth.decaying}}</text>
        <text class="stat-cell-label">衰退</text>
      </view>
    </view>

    <block wx:if="{{factorHealth.top.length}}">
      <view wx:for="{{factorHealth.top}}" wx:key="name" class="stat-row" style="padding:10rpx 0">
        <view style="display:flex;align-items:center;gap:10rpx;flex:1;min-width:0">
          <text style="font-size:24rpx;color:#1C1C1E;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{item.name}}</text>
          <text class="badge {{item.statusBadge}}" style="font-size:18rpx">{{item.status}}</text>
        </view>
        <text style="font-size:22rpx;color:#8E8E93;margin-right:12rpx">IC {{item.rollingIc}}</text>
        <text style="font-size:24rpx;font-weight:600" class="{{item.statusCls}}">{{item.score}}</text>
      </view>
    </block>
  </view>

  <!-- 调度器 (v5) -->
  <view class="card" wx:if="{{scheduler.jobCount > 0}}">
    <text class="card-title">调度器</text>
    <view style="display:flex;align-items:center;gap:12rpx;margin-bottom:16rpx">
      <text class="dot {{scheduler.running ? 'dot-green' : 'dot-red'}}"></text>
      <text style="font-size:26rpx;color:#1C1C1E">{{scheduler.running ? '运行中' : '已停止'}}</text>
      <text style="font-size:22rpx;color:#8E8E93;margin-left:auto">{{scheduler.jobCount}} 个任务</text>
    </view>

    <block wx:if="{{scheduler.jobs.length}}">
      <view wx:for="{{scheduler.jobs}}" wx:key="name" class="stat-row" style="padding:10rpx 0">
        <view style="flex:1;min-width:0">
          <text style="font-size:24rpx;color:#1C1C1E;display:block">{{item.name}}</text>
          <text style="font-size:20rpx;color:#C7C7CC">{{item.cron}}</text>
        </view>
        <view style="display:flex;align-items:center;gap:12rpx;flex-shrink:0">
          <text style="font-size:20rpx;color:#8E8E93">跑 {{item.runs}} 次</text>
          <text wx:if="{{item.hasError}}" style="font-size:20rpx;color:#FF3B30">⚠{{item.errors}}</text>
          <text class="badge {{item.running ? 'badge-green' : 'badge-gray'}}" style="font-size:18rpx">{{item.running ? '运行' : '停止'}}</text>
        </view>
      </view>
    </block>
  </view>

  <!-- 进化 -->
  <view class="card">
    <text class="card-title">自进化</text>
    <block wx:if="{{evolution.hasData}}">
      <view style="background:#F2F2F7;border-radius:16rpx;padding:20rpx;margin-bottom:16rpx">
        <text style="font-size:26rpx;color:#1C1C1E;line-height:1.7">{{evolution.summary}}</text>
      </view>
      <block wx:if="{{evolution.detail.length}}">
        <view wx:for="{{evolution.detail}}" wx:key="label" class="stat-row" style="padding:10rpx 0">
          <text class="stat-label">{{item.label}}</text>
          <text class="stat-value {{item.cls}}" style="font-size:24rpx">{{item.value}}</text>
        </view>
      </block>
      <text style="font-size:22rpx;color:#C7C7CC">{{evolution.time}}</text>
    </block>
    <view wx:else class="empty-state"><text>暂无进化事件</text></view>
  </view>

  <view style="text-align:center;padding:32rpx 0;color:#C7C7CC;font-size:22rpx">
    XAUUSD Quant Monitor · v5
  </view>

</scroll-view>
