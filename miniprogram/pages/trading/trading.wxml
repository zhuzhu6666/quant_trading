<scroll-view class="scroll-page" scroll-y>

  <!-- 连接状态 -->
  <view class="conn-bar {{connected ? 'conn-ok' : 'conn-off'}}">
    <text class="dot {{connected ? 'dot-green' : 'dot-gray'}}"></text>
    <text>{{connLabel}}</text>
  </view>

  <!-- 账户 -->
  <view class="card">
    <text class="card-title">账户</text>
    <view class="stats-grid" style="margin-bottom:16rpx">
      <view class="stat-cell">
        <text class="stat-cell-value text-dark">{{equity}}</text>
        <text class="stat-cell-label">净值</text>
      </view>
      <view class="stat-cell">
        <text class="stat-cell-value text-dark">{{balance}}</text>
        <text class="stat-cell-label">余额</text>
      </view>
      <view class="stat-cell">
        <text class="stat-cell-value {{pnlCls}}">{{pnl}}</text>
        <text class="stat-cell-label">今日盈亏</text>
      </view>
    </view>
    <view class="stat-row" style="border:none">
      <text class="stat-label">XAUUSD</text>
      <text class="stat-value" style="font-size:38rpx;font-weight:700">{{price}}</text>
    </view>
    <view wx:if="{{currency}}" style="margin-top:12rpx;text-align:right">
      <text style="font-size:22rpx;color:#8E8E93">币种: {{currency}}</text>
    </view>
  </view>

  <!-- 持仓 -->
  <view class="card">
    <text class="card-title">持仓</text>
    <block wx:if="{{positions.length > 0}}">
      <view wx:for="{{positions}}" wx:key="symbol" wx:for-item="p" style="margin-bottom:{{index < positions.length - 1 ? '16rpx' : '0'}}">
        <view wx:if="{{p.symbol}}" style="margin-bottom:8rpx">
          <text style="font-size:22rpx;color:#8E8E93">{{p.symbol}}</text>
        </view>
        <view class="stats-grid" style="margin-bottom:12rpx">
          <view class="stat-cell">
            <text class="stat-cell-value {{p.dirCls}}" style="font-size:32rpx">{{p.dir}}</text>
            <text class="stat-cell-label">方向</text>
          </view>
          <view class="stat-cell">
            <text class="stat-cell-value text-dark">{{p.entry}}</text>
            <text class="stat-cell-label">入场价</text>
          </view>
          <view class="stat-cell">
            <text class="stat-cell-value text-dark">{{p.size}}</text>
            <text class="stat-cell-label">手数</text>
          </view>
        </view>
        <view style="text-align:center;padding:12rpx;background:#F2F2F7;border-radius:14rpx">
          <text style="font-size:22rpx;color:#8E8E93;display:block;margin-bottom:2rpx">浮动盈亏</text>
          <text style="font-size:36rpx;font-weight:700;font-variant-numeric:tabular-nums" class="{{p.pnlCls}}">{{p.pnl}}</text>
        </view>
      </view>
    </block>
    <view wx:else class="empty-state">
      <text>📭 当前无持仓</text>
    </view>
  </view>

  <!-- 最近信号 -->
  <view class="card" wx:if="{{signals.length}}">
    <text class="card-title">最近信号</text>
    <view style="background:#F2F2F7;border-radius:16rpx;padding:16rpx;margin-bottom:12rpx" wx:if="{{signalReason}}">
      <text style="font-size:22rpx;color:#8E8E93">{{signalReason}}</text>
    </view>
    <view wx:for="{{signals}}" wx:key="index" class="stat-row" style="padding:12rpx 0">
      <view style="display:flex;align-items:center;gap:12rpx;flex:1;min-width:0">
        <text style="font-size:24rpx;font-weight:600;width:72rpx" class="{{item.dirCls}}">{{item.dir}}</text>
        <text style="font-size:24rpx;color:#1C1C1E">score {{item.score}}</text>
        <text style="font-size:20rpx;color:#8E8E93">{{item.nFactors}}因子</text>
      </view>
      <view style="display:flex;align-items:center;gap:12rpx;flex-shrink:0">
        <text style="font-size:20rpx;color:#8E8E93">战术 {{item.tactical}}</text>
        <text class="badge {{item.gateBadge}}" style="font-size:18rpx">{{item.gate}}</text>
      </view>
    </view>
  </view>

  <!-- 交易决策 -->
  <view class="card" wx:if="{{hasVotes}}">
    <text class="card-title">交易决策</text>
    <!-- 决策流程 -->
    <view style="display:flex;flex-direction:column;gap:0">
      <!-- 第1步: 信号 -->
      <view style="display:flex;align-items:center;padding:12rpx 0">
        <view style="width:48rpx;height:48rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;margin-right:16rpx;background:{{compDirCls === 'text-green' ? '#34C759' : compDirCls === 'text-red' ? '#FF3B30' : '#C7C7CC'}}20">
          <text style="font-size:28rpx">1</text>
        </view>
        <view style="flex:1">
          <text style="font-size:26rpx;font-weight:600;color:#1C1C1E;display:block">{{compDir}} {{compScore}}</text>
          <text style="font-size:22rpx;color:#8E8E93">合成信号 · 战术 {{compTactical}} · 宏观 {{compMacro}}</text>
        </view>
        <text class="badge {{compPassed ? 'badge-green' : 'badge-red'}}" style="font-size:20rpx">{{compPassed ? '✓ 通过' : '✗ 拦截'}}</text>
      </view>
      <!-- 分隔线 -->
      <view style="width:2rpx;height:16rpx;background:#E5E5EA;margin-left:23rpx"></view>
      <!-- 第2步: 闸门 -->
      <view style="display:flex;align-items:center;padding:12rpx 0">
        <view style="width:48rpx;height:48rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;margin-right:16rpx;background:#F2F2F7">
          <text style="font-size:28rpx;color:#8E8E93">2</text>
        </view>
        <view style="flex:1">
          <text style="font-size:26rpx;font-weight:600;color:#1C1C1E;display:block">闸门判定</text>
          <text style="font-size:22rpx;color:{{compGateCls}}">{{compGateDetail}}</text>
        </view>
        <text class="badge {{compGateBadge}}" style="font-size:20rpx">{{compGate}}</text>
      </view>
      <!-- 分隔线 -->
      <view style="width:2rpx;height:16rpx;background:#E5E5EA;margin-left:23rpx"></view>
      <!-- 第3步: 结果 -->
      <view style="display:flex;align-items:center;padding:12rpx 0">
        <view style="width:48rpx;height:48rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;margin-right:16rpx;background:{{compPassed ? '#34C75920' : '#FF3B3020'}}">
          <text style="font-size:28rpx;color:{{compPassed ? '#34C759' : '#FF3B30'}}">3</text>
        </view>
        <view style="flex:1">
          <text style="font-size:26rpx;font-weight:600;color:#1C1C1E;display:block">{{compPassed ? '开仓 ' + compDir : '不开仓'}}</text>
          <text style="font-size:22rpx;color:#8E8E93">{{compDecisionReason}}</text>
        </view>
        <text style="font-size:36rpx">{{compPassed ? '📤' : '🛑'}}</text>
      </view>
    </view>
  </view>

  <!-- 因子投票 -->
  <view class="card" wx:if="{{hasVotes}}">
    <text class="card-title">因子投票</text>
    <!-- 合成信号摘要 -->
    <view style="display:flex;align-items:center;justify-content:space-between;padding:16rpx;background:#F2F2F7;border-radius:14rpx;margin-bottom:16rpx">
      <view style="display:flex;align-items:center;gap:12rpx">
        <text style="font-size:24rpx;font-weight:600" class="{{compDirCls}}">{{compDir}}</text>
        <text style="font-size:20rpx;color:#8E8E93">合成 {{compScore}}</text>
      </view>
      <view style="display:flex;align-items:center;gap:8rpx">
        <text class="badge {{compPassed ? 'badge-green' : 'badge-orange'}}" style="font-size:18rpx">{{compGate}}</text>
        <text style="font-size:18rpx;color:#8E8E93">L{{voteLong}}/S{{voteShort}}/F{{voteFlat}}</text>
      </view>
    </view>
    <!-- 各因子投票条 -->
    <block wx:for="{{voteList}}" wx:key="name">
      <view style="display:flex;align-items:center;gap:12rpx;padding:8rpx 0">
        <text style="font-size:22rpx;color:#8E8E93;width:80rpx;text-align:right;flex-shrink:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{item.name}}</text>
        <view class="progress-bar" style="flex:1;height:8rpx">
          <view class="progress-fill {{item.barCls}}" style="width:{{item.barPct}}%;min-width:4rpx"></view>
        </view>
        <text style="font-size:20rpx;width:80rpx;flex-shrink:0" class="{{item.signalCls}}">{{item.signal}}</text>
      </view>
    </block>
  </view>

  <!-- 今日统计 -->
  <view class="card">
    <text class="card-title">今日统计</text>
    <view class="stats-grid" style="margin-bottom:16rpx">
      <view class="stat-cell">
        <text class="stat-cell-value text-dark">{{trades}}</text>
        <text class="stat-cell-label">交易</text>
      </view>
      <view class="stat-cell">
        <text class="stat-cell-value text-green">{{wins}}</text>
        <text class="stat-cell-label">胜</text>
      </view>
      <view class="stat-cell">
        <text class="stat-cell-value text-red">{{losses}}</text>
        <text class="stat-cell-label">负</text>
      </view>
      <view class="stat-cell">
        <text class="stat-cell-value {{winRateCls}}">{{winRate}}</text>
        <text class="stat-cell-label">胜率</text>
      </view>
    </view>
    <view style="margin-top:8rpx">
      <view style="display:flex;justify-content:space-between;margin-bottom:6rpx">
        <text style="font-size:22rpx;color:#8E8E93">胜率</text>
        <text style="font-size:22rpx;color:#8E8E93">{{winRate}}</text>
      </view>
      <view class="progress-bar">
        <view class="progress-fill {{winRateBarCls}}" style="width:{{winRateBar}}%"></view>
      </view>
    </view>
  </view>

  <!-- 风控 -->
  <view class="card">
    <text class="card-title">风控</text>
    <!-- 上排：熔断器独立居中 -->
    <view style="display:flex;align-items:center;justify-content:center;padding:20rpx 0;margin-bottom:20rpx;background:#F2F2F7;border-radius:16rpx">
      <text style="font-size:48rpx;margin-right:16rpx">{{circuitBreaker ? '⚠️' : '✓'}}</text>
      <view>
        <text style="font-size:26rpx;font-weight:600;color:#1C1C1E;display:block">熔断器</text>
        <text style="font-size:22rpx;color:{{circuitBreaker ? '#FF3B30' : '#34C759'}}">{{circuitBreaker ? '已触发' : '正常'}}</text>
      </view>
    </view>
    <!-- 下排：连续亏损 + 最大回撤 -->
    <view class="stats-grid">
      <view class="stat-cell">
        <text class="stat-cell-value {{consecLoss >= 3 ? 'text-red' : 'text-dark'}}">{{consecLoss}}</text>
        <text class="stat-cell-label">连续亏损</text>
      </view>
      <view class="stat-cell">
        <text class="stat-cell-value text-red">{{drawdown}}</text>
        <text class="stat-cell-label">最大回撤</text>
      </view>
    </view>
  </view>

</scroll-view>
