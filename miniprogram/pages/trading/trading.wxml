<scroll-view class="scroll-page" scroll-y>

  <!-- 连接状态 -->
  <view class="conn-bar {{connected ? 'conn-ok' : 'conn-off'}}">
    <text class="dot {{connected ? 'dot-green' : 'dot-gray'}}"></text>
    <text>{{connLabel}}</text>
  </view>

  <!-- ═══ 账户 ═══ -->
  <view class="card">
    <text class="card-title">账户</text>
    <view class="acct-grid">
      <view class="acct-cell">
        <text class="acct-value text-dark">{{equity}}</text>
        <text class="acct-label">净值</text>
      </view>
      <view class="acct-cell">
        <text class="acct-value text-dark">{{balance}}</text>
        <text class="acct-label">余额</text>
      </view>
      <view class="acct-cell">
        <text class="acct-value {{pnlCls}}">{{pnl}}</text>
        <text class="acct-label">今日盈亏</text>
      </view>
    </view>
    <view class="price-row">
      <text class="price-label">XAUUSD</text>
      <text class="price-value">{{price}}</text>
    </view>
    <view wx:if="{{currency}}" style="margin-top:10rpx;text-align:right">
      <text style="font-size:21rpx;color:#8E8E93">币种: {{currency}}</text>
    </view>
  </view>

  <!-- ═══ 合约口径 ═══ -->
  <view class="card">
    <text class="card-title">合约口径</text>
    <view class="spec-grid">
      <view class="spec-cell">
        <text class="spec-value">{{contractOz}} oz</text>
        <text class="spec-label">合约基准</text>
      </view>
      <view class="spec-cell">
        <text class="spec-value">{{pointSize}}</text>
        <text class="spec-label">1点</text>
      </view>
      <view class="spec-cell">
        <text class="spec-value">{{pointValuePerContract}}</text>
        <text class="spec-label">每点收益</text>
      </view>
      <view class="spec-cell">
        <text class="spec-value" style="font-size:28rpx">{{contractNotional}}</text>
        <text class="spec-label">合约名义</text>
      </view>
    </view>
    <view class="tip-box">
      <text class="tip-title">📐 换算说明</text>
      <text class="tip-body">当前页面按 cTrader API 口径展示；持仓尺寸字段显示 API 实际数量。</text>
    </view>
  </view>

  <!-- ═══ 持仓 ═══ -->
  <view class="card">
    <text class="card-title">持仓</text>
    <block wx:if="{{positions.length > 0}}">
      <view wx:for="{{positions}}" wx:key="symbol" wx:for-item="p">
        <view class="pos-card">
          <view class="pos-header">
            <text class="pos-symbol">{{p.symbol}}</text>
          </view>
          <view class="pos-grid">
            <view class="pos-cell">
              <text class="pos-cell-val {{p.dirCls}}">{{p.dir}}</text>
              <text class="pos-cell-lbl">方向</text>
            </view>
            <view class="pos-cell">
              <text class="pos-cell-val text-dark">{{p.entry}}</text>
              <text class="pos-cell-lbl">入场价</text>
            </view>
            <view class="pos-cell">
              <text class="pos-cell-val text-dark">{{p.size}}</text>
              <text class="pos-cell-lbl">手数</text>
            </view>
            <view class="pos-cell">
              <text class="pos-cell-val text-dark">{{p.apiSize}}</text>
              <text class="pos-cell-lbl">API量</text>
            </view>
          </view>
          <view class="pos-pnl-box">
            <text class="pos-pnl-lbl">浮动盈亏</text>
            <text class="pos-pnl-val {{p.pnlCls}}">{{p.pnl}}</text>
          </view>
        </view>
      </view>
    </block>
    <view wx:else class="empty-state">
      <text>📭 当前无持仓</text>
    </view>
  </view>

  <!-- ═══ 最近信号 ═══ -->
  <view class="card" wx:if="{{signals.length}}">
    <text class="card-title">最近信号</text>
    <view class="tip-box" style="margin-bottom:14rpx" wx:if="{{signalReason}}">
      <text class="tip-body" style="color:#636366">{{signalReason}}</text>
    </view>
    <view wx:for="{{signals}}" wx:key="index" class="stat-row" style="padding:12rpx 0">
      <view style="display:flex;align-items:center;gap:12rpx;flex:1;min-width:0">
        <text style="font-size:24rpx;font-weight:600;width:72rpx" class="{{item.dirCls}}">{{item.dir}}</text>
        <text style="font-size:24rpx;color:#1C1C1E">score {{item.score}}</text>
        <text style="font-size:20rpx;color:#8E8E93">{{item.nFactors}}因子</text>
      </view>
      <view style="display:flex;align-items:center;gap:12rpx;flex-shrink:0">
        <text style="font-size:20rpx;color:#8E8E93">战术 {{item.tactical}}</text>
        <text class="badge {{item.gateBadge}}" style="font-size:18rpx">{{item.gate}}</text>
      </view>
    </view>
  </view>

  <!-- ═══ 交易决策 ═══ -->
  <view class="card">
    <text class="card-title">交易决策</text>
    <block wx:if="{{hasVotes}}">
    <view style="display:flex;flex-direction:column;gap:0">
      <!-- 第1步: 信号 -->
      <view style="display:flex;align-items:center;padding:12rpx 0">
        <view class="step-circle" style="background:{{compDirCls === 'text-green' ? '#34C759' : compDirCls === 'text-red' ? '#FF3B30' : '#C7C7CC'}}20">
          <text style="font-size:28rpx">1</text>
        </view>
        <view class="step-detail">
          <text class="step-title">{{compDir}} {{compScore}}</text>
          <text class="step-sub">合成信号 · 战术 {{compTactical}} · 宏观 {{compMacro}}</text>
        </view>
        <text class="badge {{compPassed ? 'badge-green' : 'badge-red'}}" style="font-size:20rpx">{{compPassed ? '✓ 通过' : '✗ 拦截'}}</text>
      </view>
      <view class="step-line"></view>
      <!-- 第2步: 闸门 -->
      <view style="display:flex;align-items:center;padding:12rpx 0">
        <view class="step-circle" style="background:#F2F2F7">
          <text style="font-size:28rpx;color:#8E8E93">2</text>
        </view>
        <view class="step-detail">
          <text class="step-title">闸门判定</text>
          <text class="step-sub" style="color:{{compGateCls}}">{{compGateDetail}}</text>
        </view>
        <text class="badge {{compGateBadge}}" style="font-size:20rpx">{{compGate}}</text>
      </view>
      <view class="step-line"></view>
      <!-- 第3步: 结果 -->
      <view style="display:flex;align-items:center;padding:12rpx 0">
        <view class="step-circle" style="background:{{compPassed ? '#34C75920' : '#FF3B3020'}}">
          <text style="font-size:28rpx;color:{{compPassed ? '#34C759' : '#FF3B30'}}">3</text>
        </view>
        <view class="step-detail">
          <text class="step-title">{{compPassed ? '信号放行 ' + compDir : '不开仓'}}</text>
          <text class="step-sub">{{compDecisionReason}}</text>
        </view>
        <text style="font-size:36rpx">{{compPassed ? '📤' : '🛑'}}</text>
      </view>
    </view>
    </block>
    <view wx:else class="empty-state"><text>等待因子信号数据...</text></view>
  </view>

  <!-- ═══ 执行链路 ═══ -->
  <view class="card">
    <text class="card-title">执行链路</text>
    <view class="summary-bar">
      <view style="display:flex;align-items:center;gap:12rpx;flex:1;min-width:0">
        <text class="badge {{compPassed ? 'badge-green' : 'badge-red'}}" style="font-size:18rpx">信号 {{compPassed ? '放行' : '拦截'}}</text>
        <text class="badge {{execStageCls === 'text-green' ? 'badge-green' : execStageCls === 'text-red' ? 'badge-red' : execStageCls === 'text-orange' ? 'badge-orange' : 'badge-gray'}}" style="font-size:18rpx">执行 {{execStage}}</text>
      </view>
      <text class="exec-count">准备下单 {{execAttemptCount}} · 实际发送 {{execWireSendCount}} · 本地拦截 {{execSkipCount}} · 成功 {{execSuccessCount}} · 拒单 {{execFailCount}}</text>
    </view>

    <view class="exec-section" wx:if="{{compPassed}}">
      <text class="exec-section-label">信号层</text>
      <text class="exec-section-content">闸门放行，准备执行 {{compDir}}</text>
      <text style="font-size:20rpx;color:#8E8E93">{{compDecisionReason}}</text>
    </view>
    <view class="exec-section" wx:if="{{!compPassed}}">
      <text class="exec-section-label">信号层</text>
      <text class="exec-section-content">没有放行到执行层</text>
      <text style="font-size:20rpx;color:#8E8E93">{{compDecisionReason}}</text>
    </view>

    <view class="exec-section">
      <text class="exec-section-label">本地执行层</text>
      <text class="exec-section-content">{{execStage}}</text>
      <text style="font-size:20rpx;color:#8E8E93">{{execReason}}</text>
    </view>

    <view style="padding-top:8rpx">
      <text class="exec-section-label">最近执行事件</text>
      <block wx:if="{{execEvents.length}}">
        <view wx:for="{{execEvents}}" wx:key="index" class="exec-row">
          <text style="font-size:22rpx;font-weight:600;width:80rpx" class="{{item.stageCls}}">{{item.stage}}</text>
          <text style="font-size:18rpx;color:#C7C7CC;width:100rpx">{{item.time}}</text>
          <text class="exec-stage-label">#{{item.tick}}</text>
          <text style="font-size:20rpx;color:#8E8E93;flex:1;text-align:right">{{item.direction}}</text>
          <text class="exec-reason">{{item.reason}}</text>
        </view>
      </block>
      <view wx:else class="empty-state"><text>等待执行日志...</text></view>
    </view>
  </view>

  <!-- ═══ 因子投票 ═══ -->
  <view class="card">
    <text class="card-title">因子投票</text>
    <block wx:if="{{hasVotes}}">
    <view class="summary-bar">
      <view style="display:flex;align-items:center;gap:12rpx">
        <text style="font-size:24rpx;font-weight:600" class="{{compDirCls}}">{{compDir}}</text>
        <text style="font-size:20rpx;color:#8E8E93">合成 {{compScore}}</text>
      </view>
      <view style="display:flex;align-items:center;gap:8rpx">
        <text class="badge {{compPassed ? 'badge-green' : 'badge-orange'}}" style="font-size:18rpx">{{compGate}}</text>
        <text style="font-size:18rpx;color:#8E8E93">L{{voteLong}}/S{{voteShort}}/F{{voteFlat}}</text>
      </view>
    </view>
    <block wx:for="{{voteList}}" wx:key="name">
      <view class="vote-row">
        <text class="vote-name">{{item.name}}</text>
        <view class="vote-bar-wrap">
          <view class="progress-fill {{item.barCls}}" style="width:{{item.barPct}}%;min-width:4rpx"></view>
        </view>
        <text class="vote-signal {{item.signalCls}}">{{item.signal}}</text>
      </view>
    </block>
    </block>
    <view wx:else class="empty-state"><text>等待因子信号数据...</text></view>
  </view>

  <!-- ═══ 今日统计 ═══ -->
  <view class="card">
    <text class="card-title">今日统计</text>
    <view class="stats-grid" style="margin-bottom:16rpx">
      <view class="stat-cell">
        <text class="stat-cell-value text-dark">{{trades}}</text>
        <text class="stat-cell-label">交易</text>
      </view>
      <view class="stat-cell">
        <text class="stat-cell-value text-green">{{wins}}</text>
        <text class="stat-cell-label">胜</text>
      </view>
      <view class="stat-cell">
        <text class="stat-cell-value text-red">{{losses}}</text>
        <text class="stat-cell-label">负</text>
      </view>
      <view class="stat-cell">
        <text class="stat-cell-value {{winRateCls}}">{{winRate}}</text>
        <text class="stat-cell-label">胜率</text>
      </view>
    </view>
    <view style="margin-top:8rpx">
      <view style="display:flex;justify-content:space-between;margin-bottom:6rpx">
        <text style="font-size:22rpx;color:#8E8E93">胜率</text>
        <text style="font-size:22rpx;color:#8E8E93">{{winRate}}</text>
      </view>
      <view class="progress-bar">
        <view class="progress-fill {{winRateBarCls}}" style="width:{{winRateBar}}%"></view>
      </view>
    </view>
  </view>

  <!-- ═══ 风控 ═══ -->
  <view class="card">
    <text class="card-title">风控</text>
    <view class="risk-badge">
      <text class="risk-icon">{{circuitBreaker ? '⚠️' : '✓'}}</text>
      <view>
        <text class="risk-title">熔断器</text>
        <text class="risk-status" style="color:{{circuitBreaker ? '#FF3B30' : '#34C759'}}">{{circuitBreaker ? '已触发' : '正常'}}</text>
      </view>
    </view>
    <view class="stats-grid">
      <view class="stat-cell">
        <text class="stat-cell-value {{consecLoss >= 3 ? 'text-red' : 'text-dark'}}">{{consecLoss}}</text>
        <text class="stat-cell-label">连续亏损</text>
      </view>
      <view class="stat-cell">
        <text class="stat-cell-value text-red">{{drawdown}}</text>
        <text class="stat-cell-label">最大回撤</text>
      </view>
    </view>
  </view>

</scroll-view>
