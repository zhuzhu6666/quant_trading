/* ════════════════════════════════════════
   交易页 — 专用样式 (v2 美化)
   配合 app.wxss 全局卡片系统
   ════════════════════════════════════════ */

/* ── 账户卡片：大数字区 ── */
.acct-grid {
  display: flex;
  gap: 0;
  margin-bottom: 20rpx;
}
.acct-cell {
  flex: 1;
  text-align: center;
  position: relative;
  padding: 8rpx 0;
}
.acct-cell + .acct-cell::before {
  content: '';
  position: absolute;
  left: 0;
  top: 20%;
  height: 60%;
  width: 1rpx;
  background: rgba(60,60,67,0.08);
}
.acct-value {
  font-size: 44rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.5rpx;
  line-height: 1.15;
  display: block;
  margin-bottom: 4rpx;
}
.acct-label {
  font-size: 22rpx;
  color: #8E8E93;
  font-weight: 500;
  display: block;
}

/* ── XAUUSD 价格行 ── */
.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0 0;
  margin-top: 4rpx;
  border-top: 1rpx solid rgba(60,60,67,0.06);
}
.price-label {
  font-size: 24rpx;
  color: #8E8E93;
  font-weight: 500;
}
.price-value {
  font-size: 36rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.5rpx;
  color: #1C1C1E;
}

/* ── 合约口径：规格表 ── */
.spec-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 0;
  margin-bottom: 20rpx;
  background: #FAFAFA;
  border-radius: 16rpx;
  overflow: hidden;
}
.spec-cell {
  width: 50%;
  padding: 18rpx 16rpx;
  text-align: center;
  border-bottom: 1rpx solid rgba(60,60,67,0.05);
}
.spec-cell:nth-child(odd) {
  border-right: 1rpx solid rgba(60,60,67,0.05);
}
.spec-cell:nth-last-child(-n+2) {
  border-bottom: none;
}
.spec-value {
  font-size: 32rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  color: #1C1C1E;
  display: block;
  margin-bottom: 4rpx;
}
.spec-label {
  font-size: 21rpx;
  color: #8E8E93;
  font-weight: 500;
  display: block;
}

/* ── 说明框 ── */
.tip-box {
  background: rgba(0,122,255,0.05);
  border: 1rpx solid rgba(0,122,255,0.10);
  border-radius: 14rpx;
  padding: 16rpx 18rpx;
}
.tip-title {
  font-size: 22rpx;
  font-weight: 600;
  color: #007AFF;
  display: block;
  margin-bottom: 6rpx;
}
.tip-body {
  font-size: 20rpx;
  color: #636366;
  line-height: 1.6;
  display: block;
}

/* ── 持仓卡片 ── */
.pos-card {
  background: #F9F9FB;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 14rpx;
}
.pos-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.pos-symbol {
  font-size: 24rpx;
  font-weight: 600;
  color: #1C1C1E;
}
.pos-grid {
  display: flex;
  gap: 0;
}
.pos-cell {
  flex: 1;
  text-align: center;
}
.pos-cell + .pos-cell {
  border-left: 1rpx solid rgba(60,60,67,0.06);
}
.pos-cell-val {
  font-size: 28rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  display: block;
  margin-bottom: 2rpx;
}
.pos-cell-lbl {
  font-size: 20rpx;
  color: #8E8E93;
  display: block;
}
.pos-pnl-box {
  margin-top: 14rpx;
  padding: 14rpx;
  text-align: center;
  background: #F2F2F7;
  border-radius: 12rpx;
}
.pos-pnl-lbl {
  font-size: 20rpx;
  color: #8E8E93;
  display: block;
  margin-bottom: 2rpx;
}
.pos-pnl-val {
  font-size: 34rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

/* ── 决策流程 步骤 ── */
.step-circle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.step-line {
  width: 2rpx;
  height: 16rpx;
  background: #E5E5EA;
  margin-left: 23rpx;
}
.step-detail {
  flex: 1;
  min-width: 0;
}
.step-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1C1C1E;
  display: block;
}
.step-sub {
  font-size: 22rpx;
  color: #8E8E93;
  display: block;
}

/* ── 因子投票条 ── */
.vote-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0;
}
.vote-name {
  font-size: 22rpx;
  color: #8E8E93;
  width: 80rpx;
  text-align: right;
  flex-shrink: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.vote-bar-wrap {
  flex: 1;
  height: 8rpx;
  background: #F2F2F7;
  border-radius: 4rpx;
  overflow: hidden;
}
.vote-signal {
  font-size: 20rpx;
  width: 80rpx;
  flex-shrink: 0;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

/* ── 摘要条 ── */
.summary-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 18rpx;
  background: #FAFAFA;
  border-radius: 14rpx;
  margin-bottom: 16rpx;
}

/* ── 执行计数 ── */
.exec-count {
  font-size: 18rpx;
  color: #8E8E93;
  font-variant-numeric: tabular-nums;
}

/* ── 风控 ── */
.risk-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
  background: #F9F9FB;
  border-radius: 16rpx;
}
.risk-icon {
  font-size: 44rpx;
  margin-right: 16rpx;
}
.risk-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1C1C1E;
  display: block;
}
.risk-status {
  font-size: 22rpx;
  display: block;
}

/* ── 执行事件行 ── */
.exec-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 0;
  min-width: 0;
}
.exec-row + .exec-row {
  border-top: 1rpx solid rgba(60,60,67,0.06);
}
.exec-stage {
  font-size: 22rpx;
  font-weight: 600;
  width: 80rpx;
  flex-shrink: 0;
}
.exec-stage-label {
  font-size: 22rpx;
  color: #1C1C1E;
  flex-shrink: 0;
}
.exec-reason {
  font-size: 20rpx;
  color: #8E8E93;
  flex: 1;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}
/* ── 执行链路 section 间距 ── */
.exec-section {
  padding: 16rpx 0 20rpx 0;
  border-bottom: 1rpx solid rgba(60,60,67,0.06);
}
.exec-section:last-child {
  border-bottom: none;
}
.exec-section-label {
  font-size: 22rpx;
  color: #8E8E93;
  font-weight: 600;
  display: block;
  margin-bottom: 10rpx;
}
.exec-section-content {
  font-size: 24rpx;
  font-weight: 600;
  color: #1C1C1E;
  display: block;
  margin-bottom: 4rpx;
}
