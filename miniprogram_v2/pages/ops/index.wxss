.hero-top {
  align-items: flex-start;
  gap: 16rpx;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.ops-actions {
  min-width: 132rpx;
  align-items: stretch;
  justify-content: flex-start;
}

.btn-toolbar {
  min-height: 72rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 72rpx;
}

.btn-toolbar::after {
  border: none;
}
