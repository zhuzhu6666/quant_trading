<view class="app-shell">
  <view class="page-stack">
    <view class="hero">
      <view class="row-between hero-top">
        <view class="hero-copy">
          <view class="hero-kicker">Operations</view>
          <view class="hero-title">系统运维</view>
          <view class="hero-subtitle">调度器、演化事件、接口健康和数据库状态都在这里看。</view>
        </view>
        <view class="hero-actions ops-actions">
          <button class="btn-secondary btn-toolbar" bindtap="onRefresh">刷新</button>
        </view>
      </view>
      <view class="hero-metrics">
        <view class="hero-metric">
          <view class="hero-metric-label">API</view>
          <view class="hero-metric-value {{apiMetricClass}}">{{apiHealth.status || 'unknown'}}</view>
        </view>
        <view class="hero-metric">
          <view class="hero-metric-label">演化</view>
          <view class="hero-metric-value {{evolutionMetricClass}}">{{evolution ? 'active' : 'none'}}</view>
        </view>
        <view class="hero-metric">
          <view class="hero-metric-label">Jobs</view>
          <view class="hero-metric-value {{jobsMetricClass}}">{{scheduler && scheduler.jobs ? scheduler.jobs.length : 0}}</view>
        </view>
      </view>
    </view>

    <section-card title="接口健康" subtitle="后端是否还在稳定响应">
      <view class="status-banner status-banner-{{apiHealth.tone || 'neutral'}}">
        <view class="row-between">
          <view class="small">API</view>
          <status-pill label="{{apiHealth.status || 'unknown'}}" tone="{{apiHealth.tone || 'neutral'}}" />
        </view>
        <view class="section-note">{{apiHealth.message || apiHealth.detail || '无额外信息'}}</view>
      </view>
    </section-card>

    <section-card title="最新演化周期" subtitle="最近一次进化编排输出">
      <view wx:if="{{evolution}}" class="stack-12">
        <view class="row-between">
          <view class="value-md">{{evolution.event_type || 'cycle_complete'}}</view>
          <status-pill label="{{evolution.tone === 'negative' ? '异常' : '正常'}}" tone="{{evolution.tone}}" />
        </view>
        <view class="small muted">{{evolution.tsText}}</view>
        <view class="soft-panel section-note">这里后续可以继续挂出本轮建议数量、审批数量、应用数量，直接形成运维级闭环快照。</view>
      </view>
      <view wx:else class="empty">还没有演化事件</view>
    </section-card>

    <section-card title="调度器" subtitle="查看关键 job 是否在运行">
      <view wx:if="{{schedulerSummary}}" class="grid-3" style="margin-bottom: 18rpx;">
        <view class="split-card stack-12">
          <view class="small muted">总任务</view>
          <view class="value-md">{{schedulerSummary.total}}</view>
        </view>
        <view class="split-card stack-12">
          <view class="small muted">运行中</view>
          <view class="value-md">{{schedulerSummary.running}}</view>
        </view>
        <view class="split-card stack-12">
          <view class="small muted">累计错误</view>
          <view class="value-md">{{schedulerSummary.errors}}</view>
        </view>
      </view>
      <view wx:if="{{scheduler && scheduler.jobs && scheduler.jobs.length}}">
        <view wx:for="{{scheduler.jobs}}" wx:key="name" class="list-item">
          <view class="row-between">
            <view class="list-title">{{item.name}}</view>
            <status-pill label="{{item.running ? 'running' : 'idle'}}" tone="{{item.running ? 'positive' : 'warning'}}" />
          </view>
          <view class="row-wrap" style="margin-top: 10rpx;">
            <view class="tag">{{item.cron_expr}}</view>
            <view class="tag">run {{item.run_count}}</view>
            <view class="tag">err {{item.error_count}}</view>
          </view>
        </view>
      </view>
      <view wx:else class="empty">调度器暂时没有 job 数据</view>
    </section-card>

    <section-card title="数据库健康" subtitle="state / experiments / duckdb 总览">
      <view wx:if="{{dbCards.length}}" class="caption-grid">
        <view wx:for="{{dbCards}}" wx:key="key" class="caption-card">
          <view class="caption-label">{{item.key}}</view>
          <view class="caption-value {{item.valueClass}}">{{item.value}}</view>
        </view>
      </view>
      <view wx:else class="soft-panel section-note">暂无数据</view>
    </section-card>

    <section-card title="统一风控裁决" subtitle="最近系统放行了什么，又拦住了什么">
      <view wx:if="{{policySummary}}" class="stack-12">
        <view class="grid-3" style="margin-bottom: 18rpx;">
          <view class="split-card stack-12">
            <view class="small muted">允许</view>
            <view class="value-md accent-pos">{{policySummary.allowed}}</view>
          </view>
          <view class="split-card stack-12">
            <view class="small muted">阻断</view>
            <view class="value-md accent-neg">{{policySummary.blocked}}</view>
          </view>
          <view class="split-card stack-12">
            <view class="small muted">总数</view>
            <view class="value-md">{{policySummary.total}}</view>
          </view>
        </view>
        <view class="status-banner status-banner-{{policySummary.latestTone}}">
          <view class="row-between">
            <view class="small">最新裁决</view>
            <status-pill label="{{policySummary.latestAction}}" tone="{{policySummary.latestTone}}" />
          </view>
          <view class="section-note">{{policySummary.latestReason}}</view>
        </view>
        <view class="soft-panel stack-12">
          <view class="row-between">
            <view class="small">高频原因</view>
            <view class="small">{{policySummary.topReason}}</view>
          </view>
          <view wx:if="{{policySummary.actionRows.length}}" class="row-wrap">
            <view wx:for="{{policySummary.actionRows}}" wx:key="key" class="tag">{{item.label}} {{item.value}}</view>
          </view>
        </view>
      </view>
      <view wx:else class="soft-panel section-note">风控汇总暂时不可用</view>
    </section-card>

    <section-card title="参数治理待办" subtitle="把待审候选和新推荐直接抬到运维入口">
      <view wx:if="{{pendingTemplateCandidateCount || pendingTemplateRecommendationCount}}" class="stack-12">
        <view class="grid-3">
          <view class="split-card stack-12">
            <view class="small muted">待审候选</view>
            <view class="value-md">{{pendingTemplateCandidateCount}}</view>
          </view>
          <view class="split-card stack-12">
            <view class="small muted">在线轻调</view>
            <view class="value-md">{{onlineLightRecommendationCount}}</view>
          </view>
          <view class="split-card stack-12">
            <view class="small muted">离线深调</view>
            <view class="value-md">{{offlineDeepRecommendationCount}}</view>
          </view>
        </view>
        <view wx:if="{{pendingGovernanceTodoCard}}" class="soft-panel stack-12">
          <view class="row-between">
            <view class="small">当前主待办</view>
            <button
              class="btn-primary"
              size="mini"
              bindtap="openRecentGovernance"
              data-candidate-id="{{pendingGovernanceTodoCard.candidateId}}"
              data-recommendation-id="{{pendingGovernanceTodoCard.recommendationId}}"
              data-factor-id="{{pendingGovernanceTodoCard.factorId}}"
            >
              {{pendingGovernanceTodoCard.actionLabel}}
            </button>
          </view>
          <view class="section-note">{{pendingGovernanceTodoCard.title}}</view>
          <view class="row-wrap">
            <view wx:if="{{pendingGovernanceTodoCard.priorityLabel}}" class="tag">{{pendingGovernanceTodoCard.priorityLabel}}</view>
            <view wx:if="{{pendingGovernanceTodoCard.stageText}}" class="tag">{{pendingGovernanceTodoCard.stageText}}</view>
            <view wx:if="{{pendingGovernanceTodoCard.targetTypeText}}" class="tag">{{pendingGovernanceTodoCard.targetTypeText}}</view>
          </view>
          <view wx:if="{{pendingGovernanceTodoCard.note}}" class="section-note">{{pendingGovernanceTodoCard.note}}</view>
          <view wx:if="{{pendingGovernanceTodoCard.queueHint}}" class="small muted">{{pendingGovernanceTodoCard.queueHint}}</view>
        </view>
        <view wx:if="{{pendingCandidateCard}}" class="soft-panel stack-12">
          <view class="row-between">
            <view class="small">待审候选</view>
            <button class="btn-primary" size="mini" bindtap="openPendingCandidate">{{pendingCandidateCard.actionLabel}}</button>
          </view>
          <view class="section-note">{{pendingCandidateCard.title}}</view>
          <view class="small muted">{{pendingCandidateCard.stageText}}</view>
          <view class="small muted">{{pendingCandidateCard.note}}</view>
        </view>
        <view wx:if="{{pendingOnlineRecommendationCard}}" class="soft-panel stack-12">
          <view class="row-between">
            <view class="small">在线轻调推荐</view>
            <button class="btn-secondary" size="mini" bindtap="openPendingRecommendation">{{pendingOnlineRecommendationCard.actionLabel}}</button>
          </view>
          <view class="section-note">{{pendingOnlineRecommendationCard.title}}</view>
          <view class="small muted">{{pendingOnlineRecommendationCard.stageText}}</view>
          <view class="small muted">{{pendingOnlineRecommendationCard.note}}</view>
        </view>
        <view wx:if="{{pendingOfflineRecommendationCard}}" class="soft-panel stack-12">
          <view class="row-between">
            <view class="small">离线深调推荐</view>
            <button class="btn-secondary" size="mini" bindtap="openOfflineRecommendation">{{pendingOfflineRecommendationCard.actionLabel}}</button>
          </view>
          <view class="section-note">{{pendingOfflineRecommendationCard.title}}</view>
          <view class="small muted">{{pendingOfflineRecommendationCard.stageText}}</view>
          <view class="small muted">{{pendingOfflineRecommendationCard.note}}</view>
        </view>
      </view>
      <view wx:else class="soft-panel section-note">当前没有待处理的参数治理对象。</view>
    </section-card>

    <section-card title="交易证据查询" subtitle="按 position_id / decision_id 查看 trade-trace 与参数治理上下文">
      <view wx:if="{{totalRecentTradeTraceCount > 0}}" class="stack-12" style="margin-bottom: 18rpx;">
        <view class="small muted">最近交易样本</view>
        <input class="input" placeholder="搜索 position_id / trade_id / 因子 / 摘要" value="{{recentTraceSearch}}" bindinput="onRecentTraceSearchInput" />
        <view class="segmented">
          <view class="segmented-item {{recentTraceFilter === 'all' ? 'segmented-item-active' : ''}}" data-filter="all" bindtap="switchRecentTraceFilter">全部</view>
          <view class="segmented-item {{recentTraceFilter === 'parameter_only' ? 'segmented-item-active' : ''}}" data-filter="parameter_only" bindtap="switchRecentTraceFilter">参数问题</view>
          <view class="segmented-item {{recentTraceFilter === 'exit_only' ? 'segmented-item-active' : ''}}" data-filter="exit_only" bindtap="switchRecentTraceFilter">退出问题</view>
          <view class="segmented-item {{recentTraceFilter === 'governance_hint' ? 'segmented-item-active' : ''}}" data-filter="governance_hint" bindtap="switchRecentTraceFilter">带治理提示</view>
        </view>
        <view class="segmented" style="margin-top: 10rpx;">
          <view class="segmented-item {{recentTraceFilter === 'candidate_review' ? 'segmented-item-active' : ''}}" data-filter="candidate_review" bindtap="switchRecentTraceFilter">待审候选</view>
          <view class="segmented-item {{recentTraceFilter === 'online_light_only' ? 'segmented-item-active' : ''}}" data-filter="online_light_only" bindtap="switchRecentTraceFilter">在线轻调</view>
          <view class="segmented-item {{recentTraceFilter === 'offline_deep_only' ? 'segmented-item-active' : ''}}" data-filter="offline_deep_only" bindtap="switchRecentTraceFilter">离线深调</view>
          <view class="segmented-item {{recentTraceFilter === 'deployed_watch' ? 'segmented-item-active' : ''}}" data-filter="deployed_watch" bindtap="switchRecentTraceFilter">发布观察</view>
        </view>
        <view wx:if="{{recentTraceTodoCard}}" class="soft-panel stack-12">
          <view class="row-between">
            <view class="small">当前最该处理的样本</view>
            <button
              class="btn-primary"
              size="mini"
              catchtap="openRecentGovernance"
              data-candidate-id="{{recentTraceTodoCard.candidateId}}"
              data-recommendation-id="{{recentTraceTodoCard.recommendationId}}"
              data-factor-id="{{recentTraceTodoCard.factorId}}"
            >
              {{recentTraceTodoCard.actionLabel}}
            </button>
          </view>
          <view class="section-note">{{recentTraceTodoCard.title}}</view>
          <view class="row-wrap">
            <view wx:if="{{recentTraceTodoCard.priorityLabel}}" class="tag">{{recentTraceTodoCard.priorityLabel}}</view>
            <view wx:if="{{recentTraceTodoCard.stageTag}}" class="tag">{{recentTraceTodoCard.stageTag}}</view>
            <view wx:if="{{recentTraceTodoCard.targetTypeText}}" class="tag">{{recentTraceTodoCard.targetTypeText}}</view>
          </view>
          <view wx:if="{{recentTraceTodoCard.summary}}" class="section-note">{{recentTraceTodoCard.summary}}</view>
          <view wx:if="{{recentTraceTodoCard.queueHint}}" class="small muted">{{recentTraceTodoCard.queueHint}}</view>
        </view>
        <view wx:for="{{recentTradeTraceItems}}" wx:key="id" class="soft-panel stack-12 tap-card" data-position-id="{{item.position_id}}" data-decision-id="{{item.exit_decision_id || item.entry_decision_id}}" bindtap="openRecentTradeTrace">
          <view class="row-between">
            <view class="small">{{item.title}}</view>
            <view class="small muted">{{item.timeText}}</view>
          </view>
          <view wx:if="{{item.governancePriorityLabel}}" class="row-wrap">
            <view class="tag">{{item.governancePriorityLabel}}</view>
          </view>
          <view class="section-note">{{item.outcomeText}} · {{item.responsibilityText}}</view>
          <view wx:if="{{item.governanceText}}" class="section-note">参数治理：{{item.governanceText}}</view>
          <view wx:if="{{item.governanceStageText || item.governanceTargetTypeText}}" class="row-wrap">
            <view wx:if="{{item.governanceStageTag}}" class="tag">{{item.governanceStageTag}}</view>
            <view wx:if="{{item.governanceTargetTypeText}}" class="tag">{{item.governanceTargetTypeText}}</view>
          </view>
          <view wx:if="{{item.governancePrioritySummary}}" class="section-note">{{item.governancePrioritySummary}}</view>
          <view wx:if="{{item.governanceStageText}}" class="section-note">治理阶段：{{item.governanceStageText}}</view>
          <view wx:if="{{item.governanceStageSummary}}" class="section-note">{{item.governanceStageSummary}}</view>
          <view wx:if="{{item.governanceNextStepText}}" class="section-note">下一步：{{item.governanceNextStepText}}</view>
          <view wx:if="{{item.governanceEntryTypeText}}" class="small muted">{{item.governanceEntryTypeText}}</view>
          <view wx:if="{{item.summary_text}}" class="section-note">{{item.summary_text}}</view>
          <view wx:if="{{item.governanceCandidateId || item.governanceRecommendationId}}" class="btn-row-compact">
            <button
              class="btn-secondary"
              size="mini"
              catchtap="openRecentGovernance"
              data-candidate-id="{{item.governanceCandidateId}}"
              data-recommendation-id="{{item.governanceRecommendationId}}"
              data-factor-id="{{item.parameter_governance_factor}}"
            >
              {{item.governanceActionLabel}}
            </button>
          </view>
        </view>
        <view wx:if="{{!recentTradeTraceItems.length}}" class="soft-panel section-note">当前筛选条件下还没有最近样本。</view>
      </view>
      <view class="stack-12">
        <input class="input" placeholder="position_id，例如 268085757" value="{{tracePositionId}}" bindinput="onTracePositionInput" />
        <input class="input" placeholder="decision_id，可留空" value="{{traceDecisionId}}" bindinput="onTraceDecisionInput" />
        <button class="btn-secondary btn-block" bindtap="onQueryTradeTrace">打开证据链页面</button>
      </view>
      <view wx:if="{{recentTraceQueries.length}}" class="stack-12" style="margin-top: 16rpx;">
        <view class="small muted">最近查询</view>
        <view class="row-wrap">
          <view
            wx:for="{{recentTraceQueries}}"
            wx:key="id"
            class="tag tap-card"
            data-position-id="{{item.positionId}}"
            data-decision-id="{{item.decisionId}}"
            bindtap="replayRecentTrace"
          >
            {{item.label}}
          </view>
        </view>
        <view wx:for="{{recentTraceQueries}}" wx:key="id" class="small muted">
          {{item.label}} · {{item.sublabel}} · {{item.timeText}}
        </view>
      </view>
    </section-card>

    <section-card title="运行风险" subtitle="系统环境有没有在拖后腿">
      <view wx:if="{{systemHealthSummary}}" class="stack-12">
        <view class="grid-3" style="margin-bottom: 18rpx;">
          <view class="split-card stack-12">
            <view class="small muted">交易影响</view>
            <view class="value-md {{systemHealthSummary.tone === 'positive' ? 'accent-pos' : systemHealthSummary.tone === 'negative' ? 'accent-neg' : systemHealthSummary.tone === 'warning' ? 'accent-warn' : ''}}">{{systemHealthSummary.impactLabel}}</view>
          </view>
          <view class="split-card stack-12">
            <view class="small muted">阻断项</view>
            <view class="value-md accent-neg">{{systemHealthSummary.blockingCount}}</view>
          </view>
          <view class="split-card stack-12">
            <view class="small muted">健康分</view>
            <view class="value-md">{{systemHealthSummary.scoreText}}</view>
          </view>
        </view>
        <view class="status-banner status-banner-{{systemHealthSummary.tone}}">
          <view class="row-between">
            <view class="small">当前最该盯的点</view>
            <status-pill label="{{systemHealthSummary.impactLabel}}" tone="{{systemHealthSummary.tone}}" />
          </view>
          <view class="section-note">{{systemHealthSummary.impactSummary}}</view>
          <view class="section-note">会直接卡住开仓：{{systemHealthSummary.blockingText}}</view>
          <view class="section-note">高优先级观察项：{{systemHealthSummary.criticalText}}</view>
          <view class="section-note">一般观察项：{{systemHealthSummary.degradedText}}</view>
        </view>
        <view wx:if="{{systemHealthSummary.componentRows.length}}" class="row-wrap">
          <view wx:for="{{systemHealthSummary.componentRows}}" wx:key="key" class="tag">{{item.key}} {{item.status}}</view>
        </view>
      </view>
      <view wx:else class="soft-panel section-note">运行健康摘要暂时不可用</view>
    </section-card>
  </view>
</view>
