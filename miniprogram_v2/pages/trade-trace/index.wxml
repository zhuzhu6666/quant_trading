<view class="app-shell">
  <view class="page-stack">
    <view class="hero">
      <view class="row-between hero-top">
        <view class="hero-copy">
          <view class="hero-kicker">Trade Trace</view>
          <view class="hero-title">交易证据链</view>
          <view class="hero-subtitle">把决策、监督、复盘、执行和参数治理放在同一条证据时间线上看。</view>
        </view>
        <status-pill label="{{traceBusy ? 'loading' : (tradeTraceView ? 'ready' : 'idle')}}" tone="{{traceBusy ? 'warning' : (tradeTraceView ? 'positive' : 'neutral')}}" />
      </view>
      <view class="hero-metrics">
        <view class="hero-metric">
          <view class="hero-metric-label">position</view>
          <view class="hero-metric-value">{{tracePositionId || '--'}}</view>
        </view>
        <view class="hero-metric">
          <view class="hero-metric-label">decision</view>
          <view class="hero-metric-value">{{traceDecisionId || '--'}}</view>
        </view>
        <view class="hero-metric">
          <view class="hero-metric-label">governance</view>
          <view class="hero-metric-value">{{tradeTraceView && tradeTraceView.parameterGovernance ? 'linked' : 'none'}}</view>
        </view>
      </view>
    </view>

    <section-card title="查询状态" subtitle="当前打开的证据链">
      <view wx:if="{{traceBusy}}" class="soft-panel section-note">正在拉取交易证据，请稍候。</view>
      <view wx:elif="{{traceErrorText}}" class="status-banner status-banner-warning">
        <view class="section-note">{{traceErrorText}}</view>
      </view>
      <view wx:elif="{{tradeTraceView}}" class="soft-panel stack-12">
        <view class="row-between">
          <view class="small">position</view>
          <view class="small">{{tradeTraceView.summary.position_id || tracePositionId || '--'}}</view>
        </view>
        <view class="row-between">
          <view class="small">decision</view>
          <view class="small">{{traceDecisionId || tradeTraceView.summary.entry_decision_id || tradeTraceView.summary.exit_decision_id || '--'}}</view>
        </view>
      </view>
      <view wx:else class="soft-panel section-note">还没有收到可展示的查询参数。</view>
    </section-card>

    <section-card wx:if="{{tradeTraceView}}" title="证据汇总" subtitle="先看结论，再下钻到每段证据">
      <view class="detail-card stack-16">
        <view class="row-between">
          <view class="list-title">{{tradeTraceView.summary.position_id || '--'}}</view>
          <status-pill label="{{tradeTraceView.summary.latest_outcome || '进行中'}}" tone="{{tradeTraceView.parameterGovernance ? 'warning' : 'neutral'}}" />
        </view>
        <view class="kv-grid">
          <view class="kv-item">
            <view class="kv-label">trade_id</view>
            <view class="kv-value">{{tradeTraceView.summary.trade_id || '--'}}</view>
          </view>
          <view class="kv-item">
            <view class="kv-label">close reason</view>
            <view class="kv-value">{{tradeTraceView.summary.latest_close_reason || '--'}}</view>
          </view>
          <view class="kv-item">
            <view class="kv-label">ledger 事件</view>
            <view class="kv-value">{{tradeTraceView.summary.ledger_events || 0}}</view>
          </view>
          <view class="kv-item">
            <view class="kv-label">监督事件</view>
            <view class="kv-value">{{tradeTraceView.summary.supervisor_events || 0}}</view>
          </view>
        </view>
        <view class="soft-panel section-note">{{tradeTraceView.governanceOverviewView.opsSummary}}</view>
        <view wx:if="{{tradeTraceView.governanceOverviewView.showStageCard}}" class="soft-panel stack-12">
          <view class="row-between">
            <view class="small">治理阶段</view>
            <view class="small">{{tradeTraceView.governanceOverviewView.stageLabel}}</view>
          </view>
          <view class="row-wrap">
            <view wx:if="{{tradeTraceView.governanceOverviewView.priorityLabel}}" class="tag">{{tradeTraceView.governanceOverviewView.priorityLabel}}</view>
            <view wx:if="{{tradeTraceView.governanceOverviewView.targetType}}" class="tag">{{tradeTraceView.governanceOverviewView.targetType}}</view>
            <view wx:if="{{tradeTraceView.governanceOverviewView.actionLabel}}" class="tag">{{tradeTraceView.governanceOverviewView.actionLabel}}</view>
          </view>
          <view class="section-note">{{tradeTraceView.governanceOverviewView.stageSummary}}</view>
          <view class="section-note">下一步：{{tradeTraceView.governanceOverviewView.nextStepSummary}}</view>
        </view>
        <view wx:if="{{tradeTraceView.governanceJump && tradeTraceView.governanceJump.summary}}" class="soft-panel stack-12">
          <view class="row-between">
            <view class="small">当前建议入口</view>
            <view class="small">{{tradeTraceView.governanceJump.typeLabel || '--'}}</view>
          </view>
          <view class="section-note">{{tradeTraceView.governanceJump.summary}}</view>
        </view>
        <view wx:if="{{tradeTraceView.governanceTodo && tradeTraceView.governanceTodo.primaryTask}}" class="soft-panel stack-12">
          <view class="row-between">
            <view class="small">治理待办主任务</view>
            <view class="small">{{tradeTraceView.governanceTodo.primaryTask.typeLabel}}</view>
          </view>
          <view class="section-note">{{tradeTraceView.governanceTodo.primaryTask.title}}</view>
          <view class="section-note">{{tradeTraceView.governanceTodo.primaryTask.reason}}</view>
          <view wx:if="{{tradeTraceView.governanceTodo.primaryTask.summary}}" class="section-note">{{tradeTraceView.governanceTodo.primaryTask.summary}}</view>
          <view wx:if="{{tradeTraceView.governanceTodo.queueSummary}}" class="section-note">{{tradeTraceView.governanceTodo.queueSummary}}</view>
          <view wx:if="{{tradeTraceView.governanceTodo.queueHint}}" class="section-note">{{tradeTraceView.governanceTodo.queueHint}}</view>
          <view class="btn-row">
            <button
              class="btn-primary"
              size="mini"
              data-type="{{tradeTraceView.governanceTodo.primaryTask.type}}"
              data-suggestion-id="{{tradeTraceView.governanceTodo.primaryTask.suggestionId}}"
              data-recommendation-id="{{tradeTraceView.governanceTodo.primaryTask.recommendationId}}"
              data-candidate-id="{{tradeTraceView.governanceTodo.primaryTask.candidateId}}"
              data-lifecycle-event-id="{{tradeTraceView.governanceTodo.primaryTask.lifecycleEventId}}"
              bindtap="openTimelineGovernanceAction"
            >
              {{tradeTraceView.governanceTodo.primaryTask.buttonText}}
            </button>
          </view>
          <view wx:if="{{tradeTraceView.governanceTodo.secondaryTasks && tradeTraceView.governanceTodo.secondaryTasks.length}}" class="stack-12">
            <view class="small">备选入口</view>
            <view wx:for="{{tradeTraceView.governanceTodo.secondaryTasks}}" wx:key="targetId" class="soft-panel stack-12">
              <view class="row-between">
                <view class="small">{{item.typeLabel}}</view>
                <view class="small muted">{{item.title}}</view>
              </view>
              <view class="section-note">{{item.reason}}</view>
              <view class="btn-row">
                <button
                  class="btn-secondary"
                  size="mini"
                  data-type="{{item.type}}"
                  data-suggestion-id="{{item.suggestionId}}"
                  data-recommendation-id="{{item.recommendationId}}"
                  data-candidate-id="{{item.candidateId}}"
                  data-lifecycle-event-id="{{item.lifecycleEventId}}"
                  bindtap="openTimelineGovernanceAction"
                >
                  {{item.buttonText}}
                </button>
              </view>
            </view>
          </view>
        </view>
        <view wx:if="{{tradeTraceView.governanceOverviewView.latestCandidateTraceText}}" class="soft-panel section-note">{{tradeTraceView.governanceOverviewView.latestCandidateTraceText}}</view>
        <view wx:if="{{tradeTraceView.governanceOverviewView.latestCandidateSummaryText}}" class="soft-panel section-note">{{tradeTraceView.governanceOverviewView.latestCandidateSummaryText}}</view>
        <view wx:if="{{tradeTraceView.governanceJump && tradeTraceView.governanceJump.type}}" class="btn-row">
          <button
            class="btn-primary"
            size="mini"
            bindtap="openGovernanceAction"
          >
            {{tradeTraceView.governanceJump.buttonText}}
          </button>
        </view>
        <view wx:if="{{tradeTraceView.governanceQuickActions && tradeTraceView.governanceQuickActions.length}}" class="stack-12">
          <view wx:for="{{tradeTraceView.governanceQuickActions}}" wx:key="type" class="soft-panel stack-12">
            <view class="row-between">
              <view class="small">{{item.label}}</view>
              <view class="small muted">{{item.type}}</view>
            </view>
            <view wx:if="{{item.summary}}" class="section-note">{{item.summary}}</view>
            <view class="btn-row">
              <button
                wx:if="{{item.type === 'template_recommendation'}}"
                class="{{item.buttonTone === 'primary' ? 'btn-primary' : 'btn-secondary'}}"
                size="mini"
                bindtap="openGovernanceRecommendation"
              >
                {{item.label}}
              </button>
              <button
                wx:if="{{item.type === 'offline_candidate'}}"
                class="{{item.buttonTone === 'primary' ? 'btn-primary' : 'btn-secondary'}}"
                size="mini"
                bindtap="openGovernanceCandidate"
              >
                {{item.label}}
              </button>
            </view>
          </view>
        </view>
        <view wx:if="{{(tradeTraceView.parameterGovernance && tradeTraceView.parameterGovernance.latest_candidate) || (tradeTraceView.parameterGovernance && tradeTraceView.parameterGovernance.recommendation)}}" class="btn-row">
          <button
            wx:if="{{!(tradeTraceView.governanceQuickActions && tradeTraceView.governanceQuickActions.length) && ((tradeTraceView.parameterGovernance.latest_candidate && tradeTraceView.parameterGovernance.latest_candidate.trace && tradeTraceView.parameterGovernance.latest_candidate.trace.recommendation_id) || (tradeTraceView.parameterGovernance.recommendation && tradeTraceView.parameterGovernance.recommendation.recommendation_id))}}"
            class="btn-primary"
            size="mini"
            bindtap="openGovernanceRecommendation"
          >
            查看治理建议
          </button>
          <button
            wx:if="{{!(tradeTraceView.governanceQuickActions && tradeTraceView.governanceQuickActions.length) && tradeTraceView.parameterGovernance.latest_candidate && tradeTraceView.parameterGovernance.latest_candidate.candidate_id}}"
            class="btn-secondary"
            size="mini"
            bindtap="openGovernanceCandidate"
          >
            查看模板候选
          </button>
        </view>
        <view wx:if="{{tradeTraceView.governanceOverviewView.entryHintText}}" class="section-note">{{tradeTraceView.governanceOverviewView.entryHintText}}</view>
        <view class="row-wrap">
          <view class="tag">账本 {{tradeTraceView.ledgerEvents.length || 0}}</view>
          <view class="tag">监督 {{tradeTraceView.summary.supervisor_events || 0}}</view>
          <view class="tag">因子 {{tradeTraceView.summary.factor_count || 0}}</view>
          <view class="tag">仓位 {{tradeTraceView.summary.position_events || 0}}</view>
          <view class="tag">订单 {{tradeTraceView.summary.order_events || 0}}</view>
        </view>
      </view>
    </section-card>

    <section-card wx:if="{{tradeTraceView && tradeTraceView.timelineItems && tradeTraceView.timelineItems.length}}" title="统一时间线" subtitle="先看顺序，再展开原始细节">
      <view class="stack-12">
        <view class="divider-title row-between">
          <view class="band-title" style="margin-bottom: 0;">时间线</view>
          <button class="btn-secondary" size="mini" data-section="timeline" bindtap="toggleTraceSection">{{traceSectionOpen.timeline ? '收起' : '展开'}}</button>
        </view>
        <view wx:if="{{traceSectionOpen.timeline && tradeTraceView.timelineView && tradeTraceView.timelineView.filters && tradeTraceView.timelineView.filters.length}}" class="row-wrap">
          <view
            wx:for="{{tradeTraceView.timelineView.filters}}"
            wx:key="key"
            class="segmented-item {{item.active ? 'segmented-item-active' : ''}}"
            data-filter="{{item.key}}"
            bindtap="switchTimelineFilter"
          >
            {{item.label}} {{item.count}}
          </view>
        </view>
        <view wx:if="{{traceSectionOpen.timeline && tradeTraceView.timelineView && tradeTraceView.timelineView.filterSummary}}" class="soft-panel section-note">{{tradeTraceView.timelineView.filterSummary}}</view>
        <view wx:if="{{traceSectionOpen.timeline && timelineFilter === 'governance' && tradeTraceView.timelineView && tradeTraceView.timelineView.governanceFilters && tradeTraceView.timelineView.governanceFilters.length}}" class="row-wrap">
          <view
            wx:for="{{tradeTraceView.timelineView.governanceFilters}}"
            wx:key="key"
            class="segmented-item {{item.active ? 'segmented-item-active' : ''}}"
            data-stage-filter="{{item.key}}"
            bindtap="switchGovernanceStageFilter"
          >
            {{item.label}} {{item.count}}
          </view>
        </view>
        <view wx:if="{{traceSectionOpen.timeline && timelineFilter === 'governance' && tradeTraceView.timelineView && tradeTraceView.timelineView.governanceStageSummary}}" class="soft-panel section-note">{{tradeTraceView.timelineView.governanceStageSummary}}</view>
        <view wx:if="{{traceSectionOpen.timeline}}" wx:for="{{tradeTraceView.timelineView.visibleItems}}" wx:key="id" class="soft-panel stack-12">
          <view class="row-between">
            <view class="small">{{item.kindText}} · {{item.title}}</view>
            <view class="small muted">{{item.timeText}}</view>
          </view>
          <view class="row-wrap">
            <view class="tag">{{item.focusText}}</view>
            <view wx:if="{{item.governanceStageTag}}" class="tag">{{item.governanceStageTag}}</view>
            <view wx:if="{{item.jumpTypeLabel}}" class="tag">{{item.jumpTypeLabel}}</view>
          </view>
          <view class="section-note">{{item.note}}</view>
          <view wx:if="{{item.governanceStageSummary}}" class="section-note">{{item.governanceStageSummary}}</view>
          <view wx:if="{{item.jumpSummary}}" class="section-note">{{item.jumpSummary}}</view>
          <view wx:if="{{item.governanceActions && item.governanceActions.length}}" class="btn-row">
            <button
              wx:for="{{item.governanceActions}}"
              wx:for-item="action"
              wx:key="type"
              class="btn-secondary"
              size="mini"
              data-type="{{action.type}}"
              data-suggestion-id="{{action.suggestionId}}"
              data-recommendation-id="{{action.recommendationId}}"
              data-candidate-id="{{action.candidateId}}"
              data-lifecycle-event-id="{{action.lifecycleEventId}}"
              data-factor-id="{{action.factorId}}"
              data-source="{{action.source}}"
              bindtap="openTimelineGovernanceAction"
            >
              {{action.buttonText}}
            </button>
          </view>
          <view wx:elif="{{item.jumpType}}" class="btn-row">
            <button
              class="btn-secondary"
              size="mini"
              data-type="{{item.jumpType}}"
              data-suggestion-id="{{item.suggestionId}}"
              data-recommendation-id="{{item.recommendationId}}"
              data-candidate-id="{{item.candidateId}}"
              data-lifecycle-event-id="{{item.lifecycleEventId}}"
              bindtap="openTimelineGovernanceAction"
            >
              {{item.jumpButtonText}}
            </button>
          </view>
        </view>
        <view wx:if="{{traceSectionOpen.timeline && tradeTraceView.timelineView && !tradeTraceView.timelineView.visibleItems.length}}" class="soft-panel section-note">当前筛选下没有事件，换一个视角再看。</view>
      </view>
    </section-card>

    <section-card wx:if="{{tradeTraceView && tradeTraceView.ledgerEvents && tradeTraceView.ledgerEvents.length}}" title="决策账本" subtitle="每次决策落账时的动作与原因">
      <view class="stack-12">
        <view class="divider-title row-between">
          <view class="band-title" style="margin-bottom: 0;">账本细节</view>
          <button class="btn-secondary" size="mini" data-section="ledger" bindtap="toggleTraceSection">{{traceSectionOpen.ledger ? '收起' : '展开'}}</button>
        </view>
        <view wx:if="{{traceSectionOpen.ledger}}" wx:for="{{tradeTraceView.ledgerEvents}}" wx:key="id" class="soft-panel stack-12">
          <view class="row-between">
            <view class="small">{{item.title}}</view>
            <view class="small muted">{{item.timeText}}</view>
          </view>
          <view class="section-note">动作：{{item.actionText}}</view>
          <view class="section-note">原因：{{item.reasonText}}</view>
          <view class="section-note">裁决：{{item.verdictText}}</view>
        </view>
      </view>
    </section-card>

    <section-card wx:if="{{tradeTraceView && tradeTraceView.supervisorView}}" title="持仓监督" subtitle="系统为什么继续拿、收紧还是主动平仓">
      <view class="stack-12">
        <view class="divider-title row-between">
          <view class="band-title" style="margin-bottom: 0;">监督细节</view>
          <button class="btn-secondary" size="mini" data-section="supervisor" bindtap="toggleTraceSection">{{traceSectionOpen.supervisor ? '收起' : '展开'}}</button>
        </view>
        <view wx:if="{{traceSectionOpen.supervisor}}" class="soft-panel stack-12">
          <view class="row-between">
            <view class="small">{{tradeTraceView.supervisorView.actionText}}</view>
            <view class="small muted">{{tradeTraceView.supervisorView.timeText}}</view>
          </view>
          <view class="section-note">{{tradeTraceView.supervisorView.reasonText}}</view>
        </view>
      </view>
    </section-card>

    <section-card wx:if="{{tradeTraceView && tradeTraceView.reviewView}}" title="复盘归因" subtitle="平仓后系统怎么评价这笔交易">
      <view class="stack-12">
        <view class="divider-title row-between">
          <view class="band-title" style="margin-bottom: 0;">复盘细节</view>
          <button class="btn-secondary" size="mini" data-section="review" bindtap="toggleTraceSection">{{traceSectionOpen.review ? '收起' : '展开'}}</button>
        </view>
        <view wx:if="{{traceSectionOpen.review}}" class="soft-panel stack-12">
          <view class="row-between">
            <view class="small">{{tradeTraceView.reviewView.outcomeText}}</view>
            <view class="small">PnL {{tradeTraceView.reviewView.pnlText}}</view>
          </view>
          <view class="section-note">主要责任：{{tradeTraceView.reviewView.responsibilityText}}</view>
          <view class="section-note">平仓原因：{{tradeTraceView.reviewView.closeReasonText}}</view>
          <view class="section-note">{{tradeTraceView.reviewView.summaryText}}</view>
        </view>
      </view>
    </section-card>

    <section-card wx:if="{{tradeTraceView && tradeTraceView.factorContributions && tradeTraceView.factorContributions.length}}" title="因子贡献" subtitle="看哪些因子在帮忙，哪些在拖累">
      <view class="stack-12">
        <view class="divider-title row-between">
          <view class="band-title" style="margin-bottom: 0;">因子细节</view>
          <button class="btn-secondary" size="mini" data-section="factors" bindtap="toggleTraceSection">{{traceSectionOpen.factors ? '收起' : '展开'}}</button>
        </view>
        <view wx:if="{{traceSectionOpen.factors}}" wx:for="{{tradeTraceView.factorContributions}}" wx:key="factor" class="soft-panel stack-12">
          <view class="row-between">
            <view class="small">{{item.factor}}</view>
            <view class="small">{{item.roleText}} {{item.contributionText}}</view>
          </view>
          <view class="section-note">责任归因：{{item.responsibilityText}}</view>
        </view>
      </view>
    </section-card>

    <section-card wx:if="{{tradeTraceView && tradeTraceView.positionLifecycle && tradeTraceView.positionLifecycle.length}}" title="仓位生命周期" subtitle="仓位从开到关经历了什么">
      <view class="stack-12">
        <view class="divider-title row-between">
          <view class="band-title" style="margin-bottom: 0;">仓位细节</view>
          <button class="btn-secondary" size="mini" data-section="position" bindtap="toggleTraceSection">{{traceSectionOpen.position ? '收起' : '展开'}}</button>
        </view>
        <view wx:if="{{traceSectionOpen.position}}" wx:for="{{tradeTraceView.positionLifecycle}}" wx:key="id" class="soft-panel stack-12">
          <view class="row-between">
            <view class="small">{{item.title}}</view>
            <view class="small muted">{{item.timeText}}</view>
          </view>
          <view class="section-note">均价：{{item.priceText}} · 净量：{{item.volumeText}}</view>
          <view class="section-note">说明：{{item.reasonText}}</view>
        </view>
      </view>
    </section-card>

    <section-card wx:if="{{tradeTraceView && tradeTraceView.orderLifecycle && tradeTraceView.orderLifecycle.length}}" title="订单执行" subtitle="订单层面如何落地">
      <view class="stack-12">
        <view class="divider-title row-between">
          <view class="band-title" style="margin-bottom: 0;">订单细节</view>
          <button class="btn-secondary" size="mini" data-section="order" bindtap="toggleTraceSection">{{traceSectionOpen.order ? '收起' : '展开'}}</button>
        </view>
        <view wx:if="{{traceSectionOpen.order}}" wx:for="{{tradeTraceView.orderLifecycle}}" wx:key="id" class="soft-panel stack-12">
          <view class="row-between">
            <view class="small">{{item.title}}</view>
            <view class="small muted">{{item.timeText}}</view>
          </view>
          <view class="section-note">状态：{{item.statusText}} · 价格：{{item.priceText}} · 数量：{{item.volumeText}}</view>
          <view wx:if="{{item.controlText}}" class="section-note">{{item.controlText}}</view>
        </view>
      </view>
    </section-card>

    <section-card wx:if="{{tradeTraceView && tradeTraceView.recoveryView}}" title="恢复状态" subtitle="重启恢复视角下的持仓状态">
      <view class="stack-12">
        <view class="divider-title row-between">
          <view class="band-title" style="margin-bottom: 0;">恢复细节</view>
          <button class="btn-secondary" size="mini" data-section="recovery" bindtap="toggleTraceSection">{{traceSectionOpen.recovery ? '收起' : '展开'}}</button>
        </view>
        <view wx:if="{{traceSectionOpen.recovery}}" class="soft-panel stack-12">
          <view class="row-between">
            <view class="small">{{tradeTraceView.recoveryView.statusText}}</view>
            <view class="small">{{tradeTraceView.recoveryView.directionText}}</view>
          </view>
          <view class="section-note">开仓价：{{tradeTraceView.recoveryView.openPriceText}} · 数量：{{tradeTraceView.recoveryView.volumeText}}</view>
          <view class="section-note">平仓原因：{{tradeTraceView.recoveryView.closeReasonText}}</view>
          <view class="section-note">恢复来源：{{tradeTraceView.recoveryView.sourceText}}</view>
        </view>
      </view>
    </section-card>
  </view>
</view>
