.section-note,
.kv-value,
.list-title,
.tag {
  max-width: 100%;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.factor-modal {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 60;
}

.factor-detail-modal {
  z-index: 70;
}

.factor-modal-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(15, 23, 42, 0.42);
}

.factor-modal-sheet {
  position: absolute;
  left: 50%;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  width: calc(100vw - 64rpx);
  max-width: 686rpx;
  max-height: 78vh;
  transform: translateX(-50%);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 60rpx rgba(15, 23, 42, 0.18);
}

.factor-modal-card {
  box-sizing: border-box;
  padding: 22rpx;
}

.factor-modal-head {
  margin-bottom: 16rpx;
  gap: 16rpx;
}

.factor-modal-title {
  min-width: 0;
}

.modal-close {
  flex: 0 0 auto;
  min-width: 128rpx;
}
