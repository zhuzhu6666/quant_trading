<view class="app-shell pnl-page">
  <view class="pnl-header">
    <view>
      <view class="hero-kicker">Realized PnL</view>
      <view class="hero-title">系统收益曲线</view>
      <view class="hero-subtitle">初始资金 500，基于所有历史系统平仓。</view>
    </view>
    <button class="refresh-btn" bindtap="onRefresh" loading="{{loading}}">刷新</button>
  </view>

  <view class="pnl-metrics">
    <view class="metric-box">
      <view class="small muted">当前系统权益</view>
      <view class="value-md {{profitToneClass}}">{{equityText}}</view>
    </view>
    <view class="metric-box">
      <view class="small muted">累计盈利</view>
      <view class="value-md {{profitToneClass}}">{{profitText}}</view>
    </view>
    <view class="metric-box">
      <view class="small muted">历史平仓</view>
      <view class="value-md">{{tradeCountText}}</view>
    </view>
    <view class="metric-box">
      <view class="small muted">胜率</view>
      <view class="value-md">{{winRateText}}</view>
    </view>
  </view>

  <view class="chart-panel">
    <view class="chart-top">
      <view>
        <view class="chart-title">系统权益曲线</view>
        <view class="chart-sub">{{chartHint}}</view>
      </view>
      <view class="range-tabs">
        <view class="range-tab {{rangeKey === '40' ? 'range-tab-active' : ''}}" data-range="40" bindtap="onRangeTap">40</view>
        <view class="range-tab {{rangeKey === '80' ? 'range-tab-active' : ''}}" data-range="80" bindtap="onRangeTap">80</view>
        <view class="range-tab {{rangeKey === 'all' ? 'range-tab-active' : ''}}" data-range="all" bindtap="onRangeTap">全量</view>
      </view>
    </view>

    <view wx:if="{{!empty}}" class="canvas-wrap">
      <canvas
        id="pnlChart"
        type="2d"
        class="pnl-canvas-native"
        bindtouchstart="onChartTouchStart"
        bindtouchmove="onChartTouchMove"
        bindtouchend="onChartTouchEnd"
      ></canvas>
    </view>
    <view wx:else class="empty">暂无历史平仓记录</view>
    <view class="chart-tip">{{selectedText}}</view>
  </view>

  <view wx:if="{{recentRows.length}}" class="trade-panel">
    <view class="trade-head">
      <view>最近平仓</view>
      <view>单笔 / 累计 / 权益</view>
    </view>
    <view wx:for="{{recentRows}}" wx:key="id" class="trade-row">
      <view class="small muted">{{item.timeText}}</view>
      <view class="trade-values">
        <text class="{{item.toneClass}}">{{item.pnlText}}</text>
        <text> / {{item.cumulativeText}} / {{item.equityText}}</text>
      </view>
    </view>
  </view>
</view>
