.pnl-page {
  padding-bottom: 40rpx;
}

.pnl-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.refresh-btn {
  flex: 0 0 auto;
  min-width: 112rpx;
  height: 58rpx;
  line-height: 58rpx;
  padding: 0 18rpx;
  margin: 0;
  border-radius: 14rpx;
  background: #007aff;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.refresh-btn::after {
  border: 0;
}

.pnl-metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.metric-box,
.chart-panel,
.trade-panel {
  border: 1rpx solid #e5edf5;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.04);
}

.metric-box {
  padding: 18rpx;
  min-height: 118rpx;
}

.chart-panel {
  padding: 18rpx 0 14rpx;
  overflow: hidden;
}

.chart-top {
  padding: 0 18rpx 14rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.chart-title {
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
}

.chart-sub,
.chart-tip {
  color: #6b7280;
  font-size: 22rpx;
  line-height: 1.45;
}

.chart-sub {
  margin-top: 6rpx;
}

.range-tabs {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.range-tab {
  min-width: 64rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 12rpx;
  background: #f1f5f9;
  color: #5f6b7a;
  font-size: 22rpx;
}

.range-tab-active {
  background: #dceaff;
  color: #007aff;
  font-weight: 700;
}

.canvas-wrap {
  width: 100%;
  height: 560rpx;
}

.pnl-canvas-native {
  width: 100%;
  height: 560rpx;
}

.chart-tip {
  min-height: 34rpx;
  padding: 8rpx 18rpx 0;
}

.trade-panel {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
}

.trade-head,
.trade-row {
  display: grid;
  grid-template-columns: 150rpx minmax(0, 1fr);
  gap: 12rpx;
}

.trade-head {
  color: #6b7280;
  font-size: 22rpx;
  margin-bottom: 8rpx;
}

.trade-row {
  padding: 14rpx 0;
  border-top: 1rpx solid #edf2f7;
}

.trade-row:first-of-type {
  border-top: 0;
}

.trade-values {
  min-width: 0;
  text-align: right;
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
