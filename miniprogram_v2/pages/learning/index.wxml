              </view>
            </view>
            <view class="small muted" style="margin-top: 16rpx; margin-bottom: 10rpx; font-weight: 700;">最近快照</view>
            <view wx:if="{{metaLightgbmSnapshots.length}}" class="timeline">
              <view wx:for="{{metaLightgbmSnapshots}}" wx:key="id" class="timeline-item">
                <view class="row-between">
                  <view class="list-title">{{item.title}}</view>
                  <status-pill label="{{item.createdAtText}}" tone="{{item.tone}}" />
                </view>
                <view class="small muted">命中率 {{item.accuracyText}} · 已评估样本 {{item.evaluatedCountText}} · 旁路记录 {{item.auditCountText}}</view>
                <view class="section-note" style="margin-top: 8rpx;">{{item.summaryText}}</view>
              </view>
            </view>
            <view wx:if="{{!metaLightgbmSnapshots.length}}" class="empty">暂无快照记录。</view>
          </block>

          <block wx:elif="{{learningPanel === 'suggestions'}}">
            <view class="segmented" style="margin-bottom: 14rpx;">
              <view class="segmented-item {{suggestionTab === 'proposed' ? 'segmented-item-active' : ''}}" data-tab="proposed" bindtap="switchSuggestionTab">待治理 {{proposedSuggestions.length}}</view>
              <view class="segmented-item {{suggestionTab === 'approved' ? 'segmented-item-active' : ''}}" data-tab="approved" bindtap="switchSuggestionTab">已批 {{approvedSuggestions.length}}</view>
              <view class="segmented-item {{suggestionTab === 'rolled_back' ? 'segmented-item-active' : ''}}" data-tab="rolled_back" bindtap="switchSuggestionTab">回滚 {{rolledBackSuggestions.length}}</view>
            </view>
            <view wx:if="{{visibleSuggestions.length}}" class="timeline">
              <view wx:for="{{visibleSuggestions}}" wx:key="suggestion_id" class="timeline-item tap-card" data-id="{{item.suggestion_id}}" bindtap="openSuggestionDetail">
                <view class="row-between">
                  <view class="list-title">{{item.scopeLabel}}</view>
                  <status-pill label="{{item.status}}" tone="{{item.tone}}" />
                </view>
                <view class="small muted">{{item.actionLabel}} · 置信度 {{item.confidenceText}} · {{item.createdText}}</view>
                <view class="soft-panel section-note" style="margin-top: 10rpx;">{{item.reasonText}}</view>
              </view>
            </view>
            <view wx:if="{{!visibleSuggestions.length}}" class="empty">当前分段没有建议。</view>
          </block>

          <block wx:elif="{{learningPanel === 'reviews'}}">
            <view wx:if="{{reviews.length}}" class="timeline">
              <view wx:for="{{reviews}}" wx:key="review_id" class="timeline-item tap-card" data-id="{{item.review_id}}" bindtap="openReviewDetail">
                <view class="row-between">
                  <view class="list-title">{{item.position_id}}</view>
                  <status-pill label="{{item.outcomeLabel}}" tone="{{item.tone}}" />
                </view>
                <view class="small muted">{{item.createdText}} · pnl {{item.pnl}}</view>
                <view class="soft-panel section-note" style="margin-top: 10rpx;">{{item.meaningText}}</view>
              </view>
            </view>
            <view wx:if="{{!reviews.length}}" class="empty">还没有复盘记录。</view>
          </block>

          <block wx:elif="{{learningPanel === 'applications'}}">
            <view wx:if="{{applications.length}}" class="timeline">
              <view wx:for="{{applications}}" wx:key="application_id" class="timeline-item tap-card" data-id="{{item.application_id}}" bindtap="openApplicationDetail">
                <view class="row-between">
                  <view class="list-title">{{item.scopeLabel}}</view>
                  <status-pill label="{{item.effectLabel}}" tone="{{item.effectTone}}" />
                </view>
                <view class="small muted">{{item.actionLabel}} · {{item.createdText}}</view>
                <view class="soft-panel section-note" style="margin-top: 10rpx;">{{item.effectSummary}}</view>
              </view>
            </view>
            <view wx:if="{{!applications.length}}" class="empty">还没有权重应用记录。</view>
          </block>

          <block wx:elif="{{learningPanel === 'offlineCandidates'}}">
            <view wx:if="{{offlineCandidates.length}}" class="timeline">
              <view wx:for="{{offlineCandidates}}" wx:key="candidate_id" class="timeline-item tap-card" data-id="{{item.candidate_id}}" bindtap="openOfflineCandidateDetail">
                <view class="row-between">
                  <view class="list-title">{{item.factorLabel}}</view>
                  <status-pill label="{{item.statusLabel}}" tone="{{item.statusTone}}" />
                </view>
                <view class="small muted">{{item.templateLabel}} · {{item.createdText}}</view>
                <view wx:if="{{item.governancePriorityLabel}}" class="row-wrap" style="margin-top: 10rpx;">
                  <view class="tag">{{item.governancePriorityLabel}}</view>
                </view>
                <view class="soft-panel section-note" style="margin-top: 10rpx;">{{item.evidenceText}}</view>
              </view>
            </view>
            <view wx:if="{{!offlineCandidates.length}}" class="empty">{{parameterTemplateEmptyStates.offline_candidates}}</view>
          </block>

          <block wx:elif="{{learningPanel === 'lifecycle'}}">
            <view wx:if="{{lifecycleEvents.length}}" class="timeline">
              <view wx:for="{{lifecycleEvents}}" wx:key="id" class="timeline-item tap-card" data-id="{{item.id}}" bindtap="openLifecycleDetail">
                <view class="row-between">
                  <view class="list-title">{{item.factorLabel}}</view>
                  <status-pill label="{{item.eventLabel}}" tone="{{item.eventTone}}" />
                </view>
                <view class="small muted">{{item.createdText}}</view>
                <view class="section-note" style="margin-top: 10rpx;">下一步：{{item.nextStepLabel}}</view>
              </view>
            </view>
            <view wx:if="{{!lifecycleEvents.length}}" class="empty">{{parameterTemplateEmptyStates.lifecycle}}</view>
          </block>

          <block wx:elif="{{learningPanel === 'recommendations'}}">
            <view wx:if="{{templateRecommendations.length}}" class="timeline">
              <view wx:for="{{templateRecommendations}}" wx:key="recommendation_id" class="timeline-item tap-card" data-id="{{item.recommendation_id}}" bindtap="openTemplateRecommendationDetail">
                <view class="row-between">
                  <view class="list-title">{{item.factorLabel}}</view>
                  <status-pill label="{{item.statusLabel}}" tone="{{item.statusTone}}" />
                </view>
                <view class="small muted">{{item.templateLabel}} · {{item.roleLabel}}</view>
                <view class="soft-panel section-note" style="margin-top: 10rpx;">{{item.reasonText}}</view>
              </view>
            </view>
            <view wx:if="{{!templateRecommendations.length}}" class="empty">{{parameterTemplateEmptyStates.recommendations}}</view>
          </block>
        </view>
      </scroll-view>
    </view>

  </view>
</view>
