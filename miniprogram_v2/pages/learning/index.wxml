<view class="app-shell">
  <view class="page-stack">
    <view class="hero">
      <view class="row-between hero-top">
        <view class="hero-copy">
          <view class="hero-kicker">Learning</view>
          <view class="hero-title">规则学习闭环</view>
          <view class="hero-subtitle">这里看系统从平仓里学到了什么，又准备如何影响下一轮权重。</view>
        </view>
        <view class="hero-actions learning-actions">
          <status-pill label="{{updatedAt}}" tone="neutral" />
        </view>
      </view>
      <view class="hero-metrics">
        <view class="hero-metric">
          <view class="hero-metric-label">待治理</view>
          <view class="hero-metric-value">{{summary.suggestions.proposed || 0}}</view>
        </view>
        <view class="hero-metric">
          <view class="hero-metric-label">已批</view>
          <view class="hero-metric-value">{{summary.suggestions.approved || 0}}</view>
        </view>
        <view class="hero-metric">
          <view class="hero-metric-label">权重应用</view>
          <view class="hero-metric-value">{{applicationCountDisplay || 0}}</view>
        </view>
        <view class="hero-metric">
          <view class="hero-metric-label">模板候选</view>
          <view class="hero-metric-value">{{offlineCandidateCountDisplay || 0}}</view>
        </view>
      </view>
    </view>

    <section-card title="元模型旁路评估" subtitle="判断系统现在该收缩、观察还是恢复；只提供建议，不直接交易">
      <view wx:if="{{metaLightgbmHasReport}}" class="status-banner status-banner-{{metaLightgbmDeploymentTone}}" style="margin-bottom: 16rpx;">
        <view class="row-between">
          <view class="small muted">模型是否在工作（旁路记录/样本）</view>
          <status-pill label="{{metaLightgbmWorkingText}}" tone="{{metaLightgbmWorkingTone}}" />
        </view>
        <view class="row-between" style="margin-top: 10rpx;">
          <view class="small muted">当前模式</view>
          <status-pill label="{{metaLightgbmDeploymentModeText}}" tone="{{metaLightgbmDeploymentTone}}" />
        </view>
        <view class="row-between" style="margin-top: 10rpx;">
          <view class="small muted">是否能上线/执行</view>
          <status-pill label="{{metaLightgbmTradingText}}" tone="{{metaLightgbmTradingTone}}" />
        </view>
        <view class="row-between" style="margin-top: 10rpx;">
          <view class="small muted">用户下一步该做什么</view>
          <status-pill label="{{metaLightgbmNextStepText}}" tone="{{metaLightgbmNextStepTone}}" />
        </view>
        <view wx:if="{{metaLightgbmDeploymentSummaryText}}" class="section-note" style="margin-top: 10rpx;">{{metaLightgbmDeploymentSummaryText}}</view>
        <view wx:if="{{metaLightgbmNextStepDetailText}}" class="section-note" style="margin-top: 8rpx;">{{metaLightgbmNextStepDetailText}}</view>
        <view wx:if="{{metaLightgbmExecutionText}}" class="section-note" style="margin-top: 8rpx;">执行说明：{{metaLightgbmExecutionText}}。</view>
        <view wx:if="{{metaLightgbmPromotionGateText && metaLightgbmPromotionGateText !== '--'}}" class="section-note" style="margin-top: 10rpx;">
          上线门控：{{metaLightgbmPromotionGateText}}
        </view>
      </view>

      <view wx:if="{{!metaLightgbmHasReport}}" class="empty">当前接口暂未返回 meta LightGBM shadow 报告。</view>

      <view wx:if="{{metaLightgbmHasReport}}" class="grid-3" style="margin-bottom: 16rpx;">
        <view class="split-card stack-12">
          <view class="small muted">命中率</view>
          <view class="value-md">{{metaLightgbmAccuracyText}}</view>
          <view class="small muted">最近预测落袋样本上的总体命中率；仅做参考。</view>
        </view>
        <view class="split-card stack-12">
          <view class="small muted">已评估样本</view>
          <view class="value-md">{{metaLightgbmEvaluatedCountText}}</view>
          <view class="small muted">模型累计做过判断并有后验反馈的样本。</view>
        </view>
        <view class="split-card stack-12">
          <view class="small muted">旁路记录</view>
          <view class="value-md">{{metaLightgbmAuditCountText}}</view>
          <view class="small muted">系统发出的旁路动作落地为建议的次数。</view>
        </view>
      </view>

      <view wx:if="{{metaLightgbmHasReport}}" class="btn-row-compact" style="margin-top: 4rpx;">
        <button class="btn-secondary" data-panel="meta" bindtap="openLearningPanel">查看模型自检与快照</button>
      </view>

      <view hidden="{{true}}">
      <view wx:if="{{metaPostureDistributionRows.length}}" class="soft-panel">
        <view class="small muted" style="margin-bottom: 10rpx;">模型最近怎么建议系统行动</view>
        <view class="kv-grid">
          <view wx:for="{{metaPostureDistributionRows}}" wx:key="key" class="kv-item">
            <view class="kv-label">{{item.label}}</view>
            <view class="kv-value">{{item.valueText}}</view>
            <view class="small muted" style="margin-top: 6rpx;">{{item.explanationText}}</view>
          </view>
        </view>
      </view>

      <view wx:if="{{metaConfusionMatrixRows.length}}" class="soft-panel" style="margin-top: 12rpx;">
        <view class="small muted" style="margin-bottom: 10rpx;">模型自检证据（预测 vs 后验标签）</view>
        <view class="section-note" style="margin-bottom: 10rpx;">此处是模型自检交叉统计，用于看模型判断和真实结果是否匹配，不直接决定交易。</view>
        <view class="kv-grid">
          <view wx:for="{{metaConfusionMatrixRows}}" wx:key="key" class="kv-item">
            <view class="kv-label">{{item.label}}</view>
            <view class="kv-value">{{item.valueText}}</view>
          </view>
        </view>
      </view>

      <view wx:if="{{metaRuleComparisonRows.length || metaRuleComparisonRawText}}" class="soft-panel diagnostic-panel">
        <view class="small muted" style="margin-bottom: 8rpx;">规则交叉比对</view>
        <view class="section-note diagnostic-intro">这里比较“原来的规则判断”和“元模型判断”是否一致。短指标直接读；不一致样本等长明细放在下方日志框里。</view>
        <view wx:if="{{metaRuleComparisonRows.length}}" class="kv-grid diagnostic-grid">
          <view wx:for="{{metaRuleComparisonRows}}" wx:key="key" class="kv-item">
            <view class="kv-label">{{item.label}}</view>
            <view class="kv-value">{{item.valueText}}</view>
          </view>
        </view>
        <view wx:if="{{metaRuleComparisonRawText}}" class="diagnostic-raw">
          <view class="row-between diagnostic-raw-head">
            <view class="small muted">原始详情</view>
            <status-pill label="可滚动" tone="neutral" />
          </view>
          <scroll-view scroll-y="true" class="embedded-log">
            <view class="embedded-log-inner">
              <text class="embedded-log-text" selectable="true">{{metaRuleComparisonRawText}}</text>
            </view>
          </scroll-view>
        </view>
      </view>

      <view wx:if="{{metaArtifactSummaryRows.length || metaArtifactSummaryRawText}}" class="soft-panel diagnostic-panel">
        <view class="small muted" style="margin-bottom: 8rpx;">证据材料摘要</view>
        <view class="section-note diagnostic-intro">这里是模型评估时引用的快照、报告和证据材料。页面只摘要关键信息，完整结构放进日志框。</view>
        <view wx:if="{{metaArtifactSummaryRows.length}}" class="kv-grid diagnostic-grid">
          <view wx:for="{{metaArtifactSummaryRows}}" wx:key="key" class="kv-item">
            <view class="kv-label">{{item.label}}</view>
            <view class="kv-value">{{item.valueText}}</view>
          </view>
        </view>
        <view wx:if="{{metaArtifactSummaryRawText}}" class="diagnostic-raw">
          <view class="row-between diagnostic-raw-head">
            <view class="small muted">原始详情</view>
            <status-pill label="可滚动" tone="neutral" />
          </view>
          <scroll-view scroll-y="true" class="embedded-log">
            <view class="embedded-log-inner">
              <text class="embedded-log-text" selectable="true">{{metaArtifactSummaryRawText}}</text>
            </view>
          </scroll-view>
        </view>
      </view>

      <view class="small muted" style="margin-top: 16rpx; margin-bottom: 10rpx; font-weight: 700;">最近快照</view>
      <view wx:if="{{metaLightgbmSnapshots.length}}">
        <view class="timeline" style="margin-top: 10rpx;">
          <view wx:for="{{metaLightgbmSnapshots}}" wx:key="id" class="timeline-item">
            <view class="row-between">
              <view class="list-title">{{item.title}}</view>
              <status-pill label="{{item.createdAtText}}" tone="{{item.tone}}" />
            </view>
            <view class="small muted">命中率 {{item.accuracyText}} · 已评估样本 {{item.evaluatedCountText}} · 旁路记录 {{item.auditCountText}}</view>
            <view class="section-note" style="margin-top: 8rpx;">{{item.summaryText}}</view>
          </view>
        </view>
      </view>
      <view wx:if="{{!metaLightgbmSnapshots.length}}" class="empty">暂无快照记录。</view>
      </view>
    </section-card>

    <view wx:if="{{summaryStatus === 'error'}}" class="status-banner status-banner-warning">
      <view class="small muted">学习摘要状态</view>
      <view class="section-note">学习摘要接口当前拉取失败或超时，页内“待治理/已批/模板候选”等摘要数字可能不是实时值。</view>
      <view wx:if="{{summaryError}}" class="small muted">{{summaryError}}</view>
    </view>

    <section-card title="学习摘要" subtitle="建议、应用、复盘的总体情况">
      <view class="progress-strip" style="margin-bottom: 18rpx;">
        <view wx:for="{{closureSteps}}" wx:key="id" class="progress-step progress-step-{{item.tone}}">
          <view class="progress-index">{{item.index}}</view>
          <view class="progress-title">{{item.title}}</view>
          <view class="progress-note">{{item.note}}</view>
        </view>
      </view>
      <view class="grid-3">
        <view class="split-card stack-12">
          <view class="small muted">复盘数</view>
          <view class="value-md">{{reviews.length || 0}}</view>
        </view>
        <view class="split-card stack-12">
          <view class="small muted">建议数</view>
          <view class="value-md">{{suggestions.length || 0}}</view>
        </view>
        <view class="split-card stack-12">
          <view class="small muted">权重应用</view>
          <view class="value-md">{{applicationCountDisplay || 0}}</view>
        </view>
        <view class="split-card stack-12">
          <view class="small muted">模板候选</view>
          <view class="value-md">{{offlineCandidateCountDisplay || 0}}</view>
        </view>
      </view>
      <view wx:if="{{observationApplicationCount > 0}}" class="section-note" style="margin-top: 14rpx;">
        另有 {{observationApplicationCount}} 条观察记录，暂未真正改动运行权重。
      </view>
      <view class="status-banner status-banner-neutral" style="margin-top: 18rpx;">
        <view class="small muted">参数治理运维摘要</view>
        <view class="section-note">{{templateOpsSummary}}</view>
      </view>
      <view wx:if="{{pendingGovernanceTodoCard}}" class="status-banner status-banner-warning" style="margin-top: 18rpx;">
        <view class="small muted">当前主待办</view>
        <view class="row-between">
          <view class="value-md">{{pendingGovernanceTodoCard.title}}</view>
          <status-pill label="{{pendingGovernanceTodoCard.stageTag || '治理推进中'}}" tone="warning" />
        </view>
        <view wx:if="{{pendingGovernanceTodoCard.priorityLabel}}" class="row-wrap" style="margin-top: 10rpx;">
          <view class="tag">{{pendingGovernanceTodoCard.priorityLabel}}</view>
        </view>
        <view class="section-note" style="margin-top: 10rpx;">下一步：{{pendingGovernanceTodoCard.actionLabel}}</view>
        <view class="section-note" style="margin-top: 10rpx;">{{pendingGovernanceTodoCard.summary}}</view>
        <view wx:if="{{pendingGovernanceTodoCard.prioritySummary}}" class="section-note" style="margin-top: 10rpx;">{{pendingGovernanceTodoCard.prioritySummary}}</view>
        <button wx:if="{{pendingGovernanceTodoCard.buttonText}}" class="btn-secondary" style="margin-top: 12rpx;" bindtap="openPendingGovernanceTodo">{{pendingGovernanceTodoCard.buttonText}}</button>
      </view>
      <view wx:if="{{latestApplication}}" class="status-banner status-banner-{{latestApplication.effectTone || 'neutral'}}" style="margin-top: 18rpx;">
        <view class="small muted">最近一次应用效果</view>
        <view class="row-between">
          <view class="value-md">{{latestApplication.scope_key}}</view>
          <status-pill label="{{latestApplication.effectLabel}}" tone="{{latestApplication.effectTone}}" />
        </view>
        <view class="section-note">{{latestApplication.effectSummary}}</view>
        <view class="section-note">{{latestApplication.effectText}}</view>
        <view class="row-between">
          <view class="small muted">{{latestApplication.isObservationOnly ? '观察记录详情' : '权重应用详情'}}</view>
          <button class="btn-secondary" size="mini" bindtap="toggleLatestApplicationDetail">
            {{latestApplicationExpanded ? '收起详情' : '查看详情'}}
          </button>
        </view>
        <view wx:if="{{latestApplicationExpanded}}" class="detail-card stack-16" style="margin-top: 14rpx;">
          <view class="row-between">
            <view class="list-title">{{latestApplication.scopeLabel}}</view>
            <status-pill label="{{latestApplication.effectLabel}}" tone="{{latestApplication.effectTone}}" />
          </view>
          <view class="kv-grid">
            <view class="kv-item">
              <view class="kv-label">bias</view>
              <view class="kv-value">{{latestApplication.bias_multiplier}}</view>
            </view>
            <view class="kv-item">
              <view class="kv-label">应用时间</view>
              <view class="kv-value">{{latestApplication.createdText}}</view>
            </view>
            <view class="kv-item">
              <view class="kv-label">后验样本</view>
              <view class="kv-value">{{latestApplication.observed_trade_count || 0}}</view>
            </view>
            <view class="kv-item">
              <view class="kv-label">基线样本</view>
              <view class="kv-value">{{latestApplication.baseline_trade_count || 0}}</view>
            </view>
            <view class="kv-item">
              <view class="kv-label">reward Δ</view>
              <view class="kv-value">{{latestApplication.delta_avg_reward}}</view>
            </view>
            <view class="kv-item">
              <view class="kv-label">最近复核</view>
              <view class="kv-value">{{latestApplication.reviewAtText}}</view>
            </view>
          </view>
          <view class="soft-panel section-note">{{latestApplication.impactText}}</view>
          <view class="soft-panel section-note">{{latestApplication.effectStatsText}}</view>
          <view wx:if="{{latestApplication.isObservationOnly}}" class="soft-panel section-note">
            这条记录目前只进入观察层，还没有真正改动运行权重，所以会出现在效果追踪里，但不会计入权重应用列表。
          </view>
        </view>
      </view>
    </section-card>

    <section-card title="策略建议" subtitle="按治理状态分段查看">
      <view class="segmented">
        <view class="segmented-item {{suggestionTab === 'proposed' ? 'segmented-item-active' : ''}}" data-tab="proposed" bindtap="switchSuggestionTab">待治理 {{proposedSuggestions.length}}</view>
        <view class="segmented-item {{suggestionTab === 'approved' ? 'segmented-item-active' : ''}}" data-tab="approved" bindtap="switchSuggestionTab">已批 {{approvedSuggestions.length}}</view>
        <view class="segmented-item {{suggestionTab === 'rolled_back' ? 'segmented-item-active' : ''}}" data-tab="rolled_back" bindtap="switchSuggestionTab">回滚 {{rolledBackSuggestions.length}}</view>
      </view>

      <view wx:if="{{visibleSuggestions.length}}" style="margin-top: 18rpx;">
        <view class="divider-title">
          <view class="band-title" style="margin-bottom: 0;">
            {{suggestionTab === 'approved' ? '已批准建议' : suggestionTab === 'rolled_back' ? '已回滚建议' : '待治理建议'}}
          </view>
        </view>
        <view wx:for="{{previewSuggestions}}" wx:key="suggestion_id" class="list-item tap-card" data-id="{{item.suggestion_id}}" bindtap="openSuggestionDetail">
          <view class="row-between">
            <view class="list-title">{{item.scopeLabel}}</view>
            <status-pill label="{{item.status}}" tone="{{item.tone}}" />
          </view>
          <view class="small muted">{{item.actionLabel}} · 置信度 {{item.confidenceText}} · {{item.createdText}}</view>
          <view wx:if="{{item.boundaryScopeLabel}}" class="small muted" style="margin-top: 6rpx;">边界 {{item.boundaryScopeLabel}}</view>
          <view class="soft-panel section-note" style="margin-top: 10rpx;">{{item.reasonText}}</view>
          <view class="section-note" style="margin-top: 10rpx;">{{item.impactText}}</view>
        </view>
        <button wx:if="{{visibleSuggestions.length > previewSuggestions.length}}" class="btn-secondary btn-block" style="margin-top: 12rpx;" data-panel="suggestions" bindtap="openLearningPanel">查看全部 {{visibleSuggestions.length}} 条</button>
      </view>

      <view wx:if="{{!suggestions.length}}" class="empty">还没有策略建议</view>
    </section-card>

    <view wx:if="{{selectedSuggestion}}" class="learning-modal learning-detail-modal" catchtouchmove="noop">
      <view class="learning-modal-mask" catchtap="closeSuggestionDetail"></view>
      <scroll-view scroll-y="true" class="learning-modal-sheet" catchtap="noop">
    <section-card title="建议详情" subtitle="证据、说明与治理状态">
      <button slot="extra" class="btn-secondary modal-close" bindtap="closeSuggestionDetail">关闭</button>
      <view class="detail-card stack-16">
        <view class="row-between">
          <view class="list-title">{{selectedSuggestion.scopeLabel}}</view>
          <status-pill label="{{selectedSuggestion.status}}" tone="{{selectedSuggestion.tone}}" />
        </view>
        <view class="kv-grid">
          <view class="kv-item">
            <view class="kv-label">建议类型</view>
            <view class="kv-value">{{selectedSuggestion.actionLabel}}</view>
          </view>
          <view class="kv-item">
            <view class="kv-label">置信度</view>
            <view class="kv-value">{{selectedSuggestion.confidenceText}}</view>
          </view>
          <view wx:if="{{selectedSuggestion.boundaryScopeLabel}}" class="kv-item">
            <view class="kv-label">边界结论</view>
            <view class="kv-value">{{selectedSuggestion.boundaryScopeLabel}}</view>
          </view>
        </view>
        <view class="soft-panel section-note">{{selectedSuggestion.reasonText}}</view>
        <view class="soft-panel section-note">{{selectedSuggestion.impactText}}</view>
        <view wx:if="{{selectedSuggestion.boundaryReasonText}}" class="soft-panel section-note">{{selectedSuggestion.boundaryReasonText}}</view>
        <view wx:if="{{selectedSuggestion.approvalPathText}}" class="soft-panel section-note">{{selectedSuggestion.approvalPathText}}</view>
        <view wx:if="{{selectedSuggestion.actionStateLabel}}" class="soft-panel stack-12">
          <view class="row-between">
            <view class="small">来源链路</view>
            <view class="small">{{selectedSuggestion.actionStateLabel}}</view>
          </view>
          <view class="section-note">{{selectedSuggestion.actionStateSummary}}</view>
        </view>
        <view wx:if="{{selectedSuggestion.evidence}}" class="kv-grid">
          <view class="kv-item">
            <view class="kv-label">样本数</view>
            <view class="kv-value">{{selectedSuggestion.evidence.sample_count || '--'}}</view>
          </view>
          <view class="kv-item">
            <view class="kv-label">平均 reward</view>
            <view class="kv-value">{{selectedSuggestion.evidence.avg_reward || '--'}}</view>
          </view>
          <view class="kv-item">
            <view class="kv-label">坏损次数</view>
            <view class="kv-value">{{selectedSuggestion.evidence.bad_loss_count || '--'}}</view>
          </view>
          <view class="kv-item">
            <view class="kv-label">经验来源</view>
            <view class="kv-value">{{selectedSuggestion.evidence.experience_id || '--'}}</view>
          </view>
        </view>
        <view class="soft-panel section-note">{{selectedSuggestion.evidenceText}}</view>
        <view wx:if="{{selectedSuggestion.evidence && selectedSuggestion.evidence.factor_breakdown}}" class="soft-panel section-note">
          因子拆解已生成，可作为后续模型接口的结构化输入。
        </view>
        <button wx:if="{{selectedSuggestion.actionStateTargetType}}" class="btn-secondary" bindtap="openSuggestionProgressTarget">{{selectedSuggestion.actionStateButtonText}}</button>
        <button class="btn-secondary" bindtap="closeSuggestionDetail">收起详情</button>
      </view>
    </section-card>
      </scroll-view>
    </view>

    <section-card title="最近复盘" subtitle="平仓后系统对结果的解释">
      <view wx:if="{{reviews.length}}">
        <view class="timeline">
        <view wx:for="{{previewReviews}}" wx:key="review_id" class="timeline-item tap-card" data-id="{{item.review_id}}" bindtap="openReviewDetail">
          <view class="row-between">
            <view class="list-title">{{item.position_id}}</view>
            <status-pill label="{{item.outcomeLabel}}" tone="{{item.tone}}" />
          </view>
          <view class="small muted">{{item.createdText}} · pnl {{item.pnl}}</view>
          <view class="soft-panel section-note" style="margin-top: 10rpx;">{{item.meaningText}}</view>
        </view>
        </view>
        <button wx:if="{{reviews.length > previewReviews.length}}" class="btn-secondary btn-block" style="margin-top: 12rpx;" data-panel="reviews" bindtap="openLearningPanel">查看全部 {{reviews.length}} 条</button>
      </view>
      <view wx:else class="empty">还没有复盘记录</view>
    </section-card>

    <view wx:if="{{selectedReview}}" class="learning-modal learning-detail-modal" catchtouchmove="noop">
      <view class="learning-modal-mask" catchtap="closeReviewDetail"></view>
      <scroll-view scroll-y="true" class="learning-modal-sheet" catchtap="noop">
    <section-card title="复盘详情" subtitle="这笔交易为什么赚，或者为什么亏">
      <button slot="extra" class="btn-secondary modal-close" bindtap="closeReviewDetail">关闭</button>
      <view class="detail-card stack-16">
        <view class="row-between">
          <view class="list-title">{{selectedReview.position_id}}</view>
          <status-pill label="{{selectedReview.outcomeLabel}}" tone="{{selectedReview.tone}}" />
        </view>
        <view class="kv-grid">
          <view class="kv-item">
            <view class="kv-label">PnL</view>
            <view class="kv-value">{{selectedReview.pnl}}</view>
          </view>
          <view class="kv-item">
            <view class="kv-label">创建时间</view>
            <view class="kv-value">{{selectedReview.createdText}}</view>
          </view>
          <view class="kv-item">
            <view class="kv-label">MAE</view>
            <view class="kv-value">{{selectedReview.mae}}</view>
          </view>
          <view class="kv-item">
            <view class="kv-label">MFE</view>
            <view class="kv-value">{{selectedReview.mfe}}</view>
          </view>
        </view>
        <view class="soft-panel section-note">{{selectedReview.meaningText}}</view>
        <view class="kv-grid">
          <view class="kv-item">
            <view class="kv-label">主要责任</view>
            <view class="kv-value">{{selectedReview.primaryResponsibilityText}}</view>
          </view>
          <view class="kv-item">
            <view class="kv-label">退出结论</view>
            <view class="kv-value">{{selectedReview.review.thesis_status_at_exit || '--'}}</view>
          </view>
        </view>
