.progress-step {
  min-height: 142rpx;
}

.progress-note {
  display: -webkit-box;
  overflow: hidden;
  word-break: break-word;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.progress-detail-list {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.progress-detail-item {
  padding: 16rpx;
  border: 1rpx solid #e5edf5;
  border-radius: 18rpx;
  background: #f8fafc;
}

.progress-detail-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #111827;
}

.progress-detail-text {
  margin-top: 8rpx;
  color: #5f6b7a;
  font-size: 22rpx;
  line-height: 1.55;
  word-break: break-word;
}

.realized-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.realized-stats {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  flex-wrap: wrap;
}

.pnl-toolbar {
  margin-top: 14rpx;
  display: grid;
  grid-template-columns: 54rpx 54rpx minmax(132rpx, 1fr) 54rpx 54rpx 76rpx;
  align-items: center;
  gap: 8rpx;
}

.pnl-tool-btn {
  width: 54rpx;
  height: 54rpx;
  min-height: 54rpx;
  padding: 0;
  margin: 0;
  border-radius: 12rpx;
  background: #eef4fb;
  color: #111827;
  font-size: 26rpx;
  line-height: 54rpx;
  text-align: center;
  box-sizing: border-box;
}

.pnl-tool-btn::after {
  border: 0;
}

.pnl-tool-btn[disabled] {
  color: #a8b3c2;
  background: #f5f7fa;
}

.pnl-tool-btn-wide {
  width: 76rpx;
  font-size: 22rpx;
}

.pnl-window-label {
  height: 54rpx;
  line-height: 54rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  color: #5f6b7a;
  font-size: 22rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.pnl-tv-card {
  margin-top: 14rpx;
  min-height: 132rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  border: 1rpx solid #d6e6ff;
  background: linear-gradient(180deg, #f8fbff 0%, #eef6ff 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.pnl-tv-title {
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
}

.pnl-tv-sub {
  margin-top: 8rpx;
  color: #5f6b7a;
  font-size: 22rpx;
  line-height: 1.45;
}

.pnl-tv-action {
  flex: 0 0 auto;
  min-width: 82rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 14rpx;
  background: #007aff;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.pnl-chart {
  position: relative;
  height: 280rpx;
  margin-top: 12rpx;
  border-radius: 16rpx;
  border: 1rpx solid #e5edf5;
  background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
  overflow: hidden;
}

.pnl-canvas {
  width: 100%;
  height: 280rpx;
  display: block;
}

.pnl-selected-row {
  margin-top: 12rpx;
  display: grid;
  grid-template-columns: 1fr 1fr 1.5fr;
  gap: 10rpx;
  padding: 12rpx 14rpx;
  border-radius: 14rpx;
  border: 1rpx solid #e5edf5;
  background: #ffffff;
}

.realized-recent {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.realized-trade-row {
  display: grid;
  grid-template-columns: 1fr 1fr 1.5fr;
  gap: 10rpx;
  padding: 12rpx 14rpx;
  border-radius: 14rpx;
  background: #f8fafc;
}
