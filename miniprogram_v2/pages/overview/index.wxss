.progress-step {
  min-height: 142rpx;
}

.progress-note {
  display: -webkit-box;
  overflow: hidden;
  word-break: break-word;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.progress-detail-list {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.progress-detail-item {
  padding: 16rpx;
  border: 1rpx solid #e5edf5;
  border-radius: 18rpx;
  background: #f8fafc;
}

.progress-detail-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #111827;
}

.progress-detail-text {
  margin-top: 8rpx;
  color: #5f6b7a;
  font-size: 22rpx;
  line-height: 1.55;
  word-break: break-word;
}
