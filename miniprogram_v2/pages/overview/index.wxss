.mini-shell {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #f2f4f8;
}

.mini-stack {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 36rpx;
}

.mini-hero,
.status-card,
.action-card,
.signal-card {
  border: 1rpx solid #e6edf5;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.05);
}

.mini-hero {
  padding: 28rpx;
  border-radius: 28rpx;
}

.hero-top {
  align-items: flex-start;
}

.hero-status {
  margin-top: 20rpx;
}

.summary-label {
  font-size: 30rpx;
  font-weight: 800;
  color: #111827;
}

.summary-text {
  color: #4b5563;
  font-size: 24rpx;
  line-height: 1.55;
}

.primary-grid,
.risk-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.signal-card,
.status-card,
.action-card {
  border-radius: 24rpx;
}

.signal-card {
  min-height: 150rpx;
  padding: 22rpx;
  box-sizing: border-box;
}

.card-label,
.detail-label {
  color: #6b7280;
  font-size: 22rpx;
}

.card-value {
  margin-top: 10rpx;
  color: #111827;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.15;
  word-break: break-all;
}

.card-hint {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 22rpx;
  line-height: 1.35;
}

.status-card {
  padding: 24rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.section-title {
  color: #111827;
  font-size: 28rpx;
  font-weight: 800;
}

.detail-list {
  margin-top: 16rpx;
}

.detail-row {
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  border-bottom: 1rpx solid #edf1f5;
}

.detail-row:last-child {
  border-bottom: 0;
}

.detail-value {
  flex: 1;
  color: #111827;
  font-size: 25rpx;
  font-weight: 700;
  text-align: right;
  word-break: break-word;
}

.risk-item {
  min-height: 118rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f7f9fc;
  box-sizing: border-box;
}

.risk-value {
  margin-top: 10rpx;
  color: #111827;
  font-size: 30rpx;
  font-weight: 800;
  word-break: break-word;
}

.position-list {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
}

.position-row {
  min-height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-bottom: 1rpx solid #edf1f5;
}

.position-row:last-child {
  border-bottom: 0;
}

.position-main {
  color: #111827;
  font-size: 25rpx;
  font-weight: 800;
}

.position-sub {
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 22rpx;
}

.position-pnl {
  flex: 0 0 auto;
  color: #111827;
  font-size: 26rpx;
  font-weight: 800;
}

.position-right {
  flex: 0 0 auto;
  max-width: 230rpx;
  text-align: right;
}

.position-fact-warning {
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  border-radius: 12rpx;
  background: #fff7e8;
  color: #9a5b00;
  font-size: 21rpx;
  line-height: 1.4;
}

.position-fact-note,
.detail-fact-note {
  margin-top: 4rpx;
  color: #9a5b00;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.35;
}

.action-card {
  padding: 20rpx;
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
}

.btn-plain {
  min-height: 80rpx;
  padding: 0 30rpx;
  border-radius: 18rpx;
  background: #f7f9fc;
  color: #4b5563;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1;
}

.btn-plain::after {
  border: 0;
}

.accent-pos {
  color: #047857 !important;
}

.accent-neg {
  color: #dc2626 !important;
}
