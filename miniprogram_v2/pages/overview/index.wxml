<view class="mini-shell">
  <view class="mini-stack">
    <view class="mini-hero">
      <view class="row-between hero-top">
        <view>
          <view class="hero-kicker">移动状态</view>
          <view class="hero-title">Quant Agent</view>
        </view>
        <status-pill label="{{wsLabel}}" tone="{{wsTone}}" />
      </view>
      <view class="hero-subtitle">完整控制台已迁移至 Web，小程序只保留关键运行状态。</view>
      <view class="status-banner status-banner-{{overallTone}} hero-status">
        <view class="summary-label">{{overallLabel}}</view>
        <view class="summary-text">{{overallText}}</view>
      </view>
    </view>

    <view class="primary-grid">
      <view class="signal-card">
        <view class="card-label">账户权益</view>
        <view class="card-value">{{equity}}</view>
        <view class="card-hint">余额 {{balance}}</view>
      </view>
      <view class="signal-card">
        <view class="card-label">持仓盈亏</view>
        <view class="card-value {{livePnlTone === 'positive' ? 'accent-pos' : livePnlTone === 'negative' ? 'accent-neg' : ''}}">{{livePnl}}</view>
        <view class="card-hint">{{positionSummary}}</view>
      </view>
      <view class="signal-card">
        <view class="card-label">会话收益</view>
        <view class="card-value {{realizedPnlTone === 'positive' ? 'accent-pos' : realizedPnlTone === 'negative' ? 'accent-neg' : ''}}">{{realizedPnl}}</view>
        <view class="card-hint">已实现收益</view>
      </view>
      <view class="signal-card">
        <view class="card-label">持仓数</view>
        <view class="card-value">{{positions}}</view>
        <view class="card-hint">当前开放仓位</view>
      </view>
    </view>

    <view class="status-card">
      <view class="section-head">
        <view class="section-title">交易循环</view>
        <status-pill label="{{loopLabel}}" tone="{{loopTone}}" />
      </view>
      <view class="detail-list">
        <view class="detail-row">
          <view class="detail-label">经纪商</view>
          <view class="detail-value">{{broker}}</view>
        </view>
        <view class="detail-row">
          <view class="detail-label">策略</view>
          <view class="detail-value">{{strategy}}</view>
        </view>
        <view wx:if="{{xauVisible}}" class="detail-row">
          <view class="detail-label">XAU 现价</view>
          <view class="detail-value">{{xauPrice}}</view>
        </view>
        <view class="detail-row">
          <view class="detail-label">更新时间</view>
          <view class="detail-value">{{updatedAt}}</view>
        </view>
      </view>
    </view>

    <view class="status-card">
      <view class="section-head">
        <view class="section-title">风控状态</view>
        <status-pill label="{{circuitLabel}}" tone="{{circuitTone}}" />
      </view>
      <view class="risk-grid">
        <view class="risk-item">
          <view class="card-label">回撤</view>
          <view class="risk-value">{{drawdown}}</view>
        </view>
        <view class="risk-item">
          <view class="card-label">连续亏损</view>
          <view class="risk-value">{{consecutiveLoss}}</view>
        </view>
        <view class="risk-item">
          <view class="card-label">数据库</view>
          <view class="risk-value">{{dbLabel}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{hasPositions}}" class="status-card">
      <view class="section-title">当前持仓</view>
      <view class="position-list">
        <view wx:for="{{positionsList}}" wx:key="id" class="position-row">
          <view>
            <view class="position-main">{{item.symbol}} · {{item.direction}}</view>
            <view class="position-sub">量 {{item.volume}} · 开仓 {{item.openPrice}}</view>
          </view>
          <view class="position-pnl {{item.tone === 'positive' ? 'accent-pos' : item.tone === 'negative' ? 'accent-neg' : ''}}">{{item.pnl}}</view>
        </view>
      </view>
    </view>

    <view class="action-card">
      <button class="btn-primary" loading="{{refreshing}}" bindtap="onRefreshTap">刷新状态</button>
      <button class="btn-secondary" bindtap="onCopyWebUrl">复制 Web 地址</button>
      <button class="btn-plain" bindtap="onLogout">退出登录</button>
    </view>
  </view>
</view>
