<view class="app-shell">
  <view class="page-stack">
    <view class="hero">
      <view class="row-between hero-top">
        <view class="hero-copy">
          <view class="hero-kicker">Trading</view>
          <view class="hero-title">交易执行与持仓监督</view>
          <view class="hero-subtitle">优先展示执行是否在线、持仓是否存在、是否可开仓，以及是否有风控/监督提醒。</view>
        </view>
        <status-pill label="{{signalLabel}}" tone="{{signalTone}}" />
      </view>
      <view class="hero-metrics trading-hero-metrics">
        <view class="hero-metric">
          <view class="hero-metric-label">交易循环</view>
          <view class="hero-metric-value">{{executionLoopText}}</view>
        </view>
        <view class="hero-metric">
          <view class="hero-metric-label">持仓状态</view>
          <view class="hero-metric-value">{{executionPositionText}}</view>
        </view>
        <view class="hero-metric">
          <view class="hero-metric-label">开仓许可</view>
          <view class="hero-metric-value">{{executionOpenText}}</view>
        </view>
        <view class="hero-metric">
          <view class="hero-metric-label">监督提醒</view>
          <view class="hero-metric-value">{{executionRiskText}}</view>
        </view>
      </view>
      <view class="status-banner status-banner-{{executionSummaryTone}}" style="margin-top: 12rpx;">
        <view class="small muted">执行结论</view>
        <view class="section-note">{{executionSummary}}</view>
      </view>
    </view>

    <view class="grid-2-1">
    <section-card title="即时摘要" subtitle="持仓与风险">
      <view class="status-banner status-banner-{{gateTone}}">
        <view class="small muted">执行姿态</view>
        <view class="row-between">
          <view class="value-md">{{gateLabel}}</view>
          <status-pill label="{{strategy.pipelineLabel}}" tone="{{strategy.pipelineRunning ? 'positive' : 'warning'}}" />
        </view>
        <view class="section-note">{{strategy.gateReason || '当前没有额外拦截原因，策略将按规则继续推进。'}}</view>
      </view>
      <view class="grid-2">
        <view class="split-card stack-12">
          <view class="small muted">当前价格</view>
          <view class="value-md">{{currentPrice}}</view>
        </view>
        <view class="split-card stack-12">
          <view class="small muted">总持仓方向</view>
          <view class="value-md">{{positionSummaryLabel}}</view>
        </view>
        <view class="split-card stack-12">
          <view class="small muted">持仓 PnL</view>
          <view class="value-md">{{daily.pnl}}</view>
        </view>
        <view class="split-card stack-12">
          <view class="small muted">仓位暴露</view>
          <view class="value-md">{{positionExposureLabel}}</view>
        </view>
      </view>
      <view class="section-note" style="margin-top: 12rpx;">持仓 PnL 只看当前开放仓位的实时盈亏；已实现盈亏在总览页按平仓成交画累计曲线。</view>
      <view class="btn-row" style="margin-top: 18rpx;">
        <button class="btn-primary {{loopRunning || startBusy || stopBusy ? 'btn-disabled' : ''}}" bindtap="onStart" loading="{{startBusy}}" disabled="{{loopRunning || startBusy || stopBusy}}">启动</button>
        <button class="btn-stop {{!loopRunning || stopBusy || startBusy ? 'btn-disabled' : ''}}" bindtap="onStop" loading="{{stopBusy}}" disabled="{{!loopRunning || stopBusy || startBusy}}">停止</button>
        <button class="btn-danger {{!positions.length || emergencyBusy ? 'btn-disabled' : ''}}" bindtap="onEmergencyClose" loading="{{emergencyBusy}}" disabled="{{!positions.length || emergencyBusy}}">紧急平仓</button>
      </view>
    </section-card>

    <section-card title="风控状态" subtitle="看系统有没有在踩刹车">
      <view class="soft-panel stack-12">
        <view class="row-between">
          <view class="small">熔断</view>
          <status-pill label="{{strategy.circuitBreaker ? '已触发' : '正常'}}" tone="{{strategy.circuitBreaker ? 'negative' : 'positive'}}" />
        </view>
        <view class="row-between">
          <view class="small">执行流水线</view>
          <status-pill label="{{strategy.pipelineRunning ? '运行中' : '已停止'}}" tone="{{strategy.pipelineRunning ? 'positive' : 'warning'}}" />
        </view>
        <view class="row-between">
          <view class="small">连续亏损</view>
          <view class="small">{{risk.consecutive_loss || 0}}</view>
        </view>
        <view class="row-between">
          <view class="small">日内交易数</view>
          <view class="small">{{daily.trades || 0}}</view>
        </view>
        <view class="row-between">
          <view class="small">已实现曲线 / 持仓 PnL</view>
          <view class="small">{{realizedPnlText}} / {{unrealizedPnlText}}</view>
        </view>
        <view wx:if="{{currentGateView}}" class="status-banner status-banner-{{currentGateView.tone}}">
          <view class="row-between">
            <view class="small">{{currentGateView.title}}</view>
            <status-pill label="{{currentGateView.status}}" tone="{{currentGateView.tone}}" />
          </view>
          <view class="section-note">{{currentGateView.summary}}</view>
          <view class="small muted">{{currentGateView.detail}}</view>
        </view>
        <view wx:if="{{policyHistoryView}}" class="status-banner status-banner-{{policyHistoryView.tone}}">
          <view class="section-note">这条记录意味着什么：{{policyHistoryView.meaning}}</view>
          <view class="row-between">
            <view class="small">{{policyHistoryView.title}}</view>
            <status-pill label="{{policyHistoryView.action}}" tone="{{policyHistoryView.tone}}" />
          </view>
          <view class="section-note">{{policyHistoryView.reason}}</view>
          <view class="small muted">发生时间：{{policyHistoryView.timeText}}</view>
          <view class="row-wrap">
            <view class="tag">已放行 {{policyHistoryView.allowed}}</view>
            <view class="tag">已拦截 {{policyHistoryView.blocked}}</view>
          </view>
        </view>
      </view>
    </section-card>
    </view>

    <section-card title="当前持仓" subtitle="仓位级别视图">
      <view wx:if="{{positions.length}}">
        <view wx:for="{{positions}}" wx:key="position_id" class="list-item">
          <view class="row-between">
            <view class="list-title">{{item.symbol || 'XAUUSD+'}}</view>
            <view class="{{item.pnlToneClass}} value-md">{{item.pnlText}}</view>
          </view>
          <view class="row-wrap" style="margin-top: 10rpx;">
            <view class="tag">{{item.directionText}}</view>
            <view class="tag">开仓 {{item.openPriceText}}</view>
            <view class="tag">量 {{item.volumeText}}</view>
            <view class="tag">已持有 {{item.holdingText}}</view>
          </view>
          <view class="status-banner status-banner-{{item.timeoutTone}}" style="margin-top: 12rpx;">
            <view class="row-between">
              <view class="small muted">持仓时长风控</view>
              <status-pill label="{{item.timeoutLabel}}" tone="{{item.timeoutTone}}" />
            </view>
            <view class="section-note">{{item.timeoutHint}}</view>
          </view>
          <view class="status-banner status-banner-{{item.supervisorTone}}" style="margin-top: 12rpx;">
            <view class="row-between">
              <view class="small muted">持仓监督结论</view>
              <status-pill label="{{item.supervisorLabel}}" tone="{{item.supervisorTone}}" />
            </view>
            <view class="section-note">{{item.supervisorSummary}}</view>
          </view>
          <view class="btn-row-compact" style="margin-top: 12rpx;">
            <button class="btn-secondary" size="mini" data-position-id="{{item.position_id}}" bindtap="openTradeTrace">查看证据链</button>
          </view>
          <view class="caption-grid" style="margin-top: 12rpx;">
            <view class="caption-card">
              <view class="caption-label">止损</view>
              <view class="caption-value">{{item.sl || item.stop_loss || '--'}}</view>
            </view>
            <view class="caption-card">
              <view class="caption-label">止盈</view>
              <view class="caption-value">{{item.tp || item.take_profit || '--'}}</view>
            </view>
            <view class="caption-card">
              <view class="caption-label">现价</view>
              <view class="caption-value">{{item.currentPriceText}}</view>
            </view>
          </view>
        </view>
      </view>
      <view wx:else class="empty">当前没有持仓</view>
    </section-card>
  </view>
</view>
