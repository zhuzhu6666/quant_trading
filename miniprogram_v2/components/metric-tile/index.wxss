.tile {
  background: linear-gradient(180deg, #ffffff 0%, #fbfcfe 100%);
  border-radius: 22rpx;
  padding: 22rpx;
  min-height: 132rpx;
  box-sizing: border-box;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.04);
}

.tile-label {
  font-size: 22rpx;
  color: #6b7280;
}

.tile-value {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.tile-hint {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #9ca3af;
}

.tone-positive {
  color: #18a957;
}

.tone-negative {
  color: #ff3b30;
}

.tone-warning {
  color: #ff9f0a;
}
