#!/usr/bin/env bash
# Root-owned bridge for the forced Windows backup SSH account.
set -euo pipefail

readonly PROJECT_ROOT="/home/ubuntu/quant_trading"
readonly DATABASE="quant_audit"

if [[ "${EUID}" -ne 0 ]]; then
  echo "quant-state-backup-bridge must run as root" >&2
  exit 77
fi

case "${1:-}" in
  dump)
    [[ "$#" -eq 1 ]] || { echo "unexpected dump arguments" >&2; exit 64; }
    exec runuser -u postgres -- /usr/bin/pg_dump \
      --dbname="${DATABASE}" \
      --format=custom \
      --compress=zstd:3 \
      --no-owner \
      --no-privileges
    ;;
  receipt)
    [[ "$#" -eq 4 ]] || { echo "receipt requires timestamp, size and sha256" >&2; exit 64; }
    [[ "$2" =~ ^[0-9]{10}$ ]] || { echo "invalid receipt timestamp" >&2; exit 64; }
    [[ "$3" =~ ^[1-9][0-9]*$ ]] || { echo "invalid receipt byte count" >&2; exit 64; }
    [[ "$4" =~ ^[0-9a-fA-F]{64}$ ]] || { echo "invalid receipt sha256" >&2; exit 64; }
    exec "${PROJECT_ROOT}/.venv/bin/python" \
      "${PROJECT_ROOT}/scripts/record_windows_pull_backup.py" \
      --completed-at "$2" \
      --byte-count "$3" \
      --sha256 "$4"
    ;;
  restore-receipt)
    [[ "$#" -eq 2 ]] || { echo "restore-receipt requires timestamp" >&2; exit 64; }
    [[ "$2" =~ ^[0-9]{10}$ ]] || { echo "invalid restore timestamp" >&2; exit 64; }
    exec "${PROJECT_ROOT}/.venv/bin/python" \
      "${PROJECT_ROOT}/scripts/record_windows_restore_drill.py" \
      --verified-at "$2"
    ;;
  --check)
    [[ "$#" -eq 1 ]] || { echo "unexpected check arguments" >&2; exit 64; }
    exec runuser -u postgres -- /usr/bin/psql -d "${DATABASE}" -Atqc \
      "SELECT current_database(), current_setting('server_version_num')"
    ;;
  *)
    echo "allowed commands: dump, receipt, restore-receipt, --check" >&2
    exit 64
    ;;
esac
