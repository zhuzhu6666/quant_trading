#!/usr/bin/env bash
# Forced-command gate. It only permits a backup stream or a validated receipt.
set -euo pipefail

readonly bridge="/usr/local/sbin/quant-state-backup-bridge"
command="${SSH_ORIGINAL_COMMAND:-}"

if [[ "${command}" == "dump" ]]; then
  exec sudo -n "${bridge}" dump
fi

if [[ "${command}" =~ ^receipt[[:space:]]+([0-9]{10})[[:space:]]+([1-9][0-9]*)[[:space:]]+([0-9a-fA-F]{64})$ ]]; then
  exec sudo -n "${bridge}" receipt "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
fi

if [[ "${command}" =~ ^restore-receipt[[:space:]]+([0-9]{10})$ ]]; then
  exec sudo -n "${bridge}" restore-receipt "${BASH_REMATCH[1]}"
fi

echo "only dump, receipt and restore-receipt are permitted" >&2
exit 64
