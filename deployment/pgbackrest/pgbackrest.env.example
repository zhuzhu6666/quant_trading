# Copy to /etc/quant/pgbackrest.env with mode 0600.
# Values here are consumed by the systemd backup units and are never committed
# with credentials.  Keep the production DSN and any provider credentials in
# the protected host configuration only.

PGBACKREST_STANZA=quant-state-v1
PGBACKREST_BIN=/usr/bin/pgbackrest
QUANT_STATE_PG_DSN=<protected-state-v1-dsn>
