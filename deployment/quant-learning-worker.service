[Unit]
Description=Quant Trading Learning and Evolution Worker
After=network-online.target postgresql.service quant-backend.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/quant_trading
Environment=PYTHONUNBUFFERED=1
Environment=QUANT_LEARNING_WORKER_CPU_AFFINITY=2,3
ExecStart=/home/ubuntu/quant_trading/.venv/bin/python /home/ubuntu/quant_trading/scripts/learning_worker.py
Restart=always
RestartSec=10
CPUAffinity=2 3

[Install]
WantedBy=multi-user.target
