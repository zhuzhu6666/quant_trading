# Quant Trading backend auth (required)
QUANT_JWT_SECRET=replace-with-32-plus-random-bytes
QUANT_AUTH_USER=zhu
QUANT_PASSWORD_HASH=replace-with-argon2id-encoded-password-hash
# Temporary migration switches only; keep disabled for a fresh deployment.
QUANT_AUTH_ALLOW_LEGACY_SHA256=0
QUANT_AUTH_ALLOW_LEGACY_ACCESS_TOKEN=0
QUANT_AUTH_ALLOW_URL_JWT=0
# Fsync'd local projection used only to keep logout effective for stop/emergency during PG outages.
QUANT_AUTH_REVOCATION_STATE_PATH=data/safety/auth_session_revocations.jsonl

# cTrader Open API
CTRADER_CLIENT_ID=your_client_id
CTRADER_CLIENT_SECRET=your_client_secret
CTRADER_ACCESS_TOKEN=your_access_token
CTRADER_REFRESH_TOKEN=your_refresh_token
CTRADER_TOKEN_EXPIRES_AT=0
CTRADER_ACCOUNT_ID=your_account_id
CTRADER_HOST=demo.ctraderapi.com
CTRADER_PORT=5035
CTRADER_SYMBOL=XAUUSD
