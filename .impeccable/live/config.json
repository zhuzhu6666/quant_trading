{
  "framework": "next",
  "port": 3000,
  "rootSelector": "html > body",
  "paths": {
    "tokens": ["frontend/tailwind.config.ts"],
    "pages": [
      "frontend/app/page.tsx",
      "frontend/app/(terminal)/paper/page.tsx",
      "frontend/app/(terminal)/live/page.tsx",
      "frontend/app/(terminal)/market/page.tsx",
      "frontend/app/(terminal)/factors/page.tsx",
      "frontend/app/(terminal)/discover/page.tsx",
      "frontend/app/(terminal)/shadow/page.tsx",
      "frontend/app/(terminal)/config/page.tsx",
      "frontend/app/(terminal)/jobs/page.tsx",
      "frontend/app/(terminal)/backtest/page.tsx",
      "frontend/app/(terminal)/tuning/page.tsx",
      "frontend/app/(terminal)/calibrator/page.tsx",
      "frontend/app/(terminal)/sync/page.tsx",
      "frontend/app/(terminal)/reports/page.tsx",
      "frontend/app/(terminal)/ab/page.tsx"
    ],
    "components": [
      "frontend/components/layout/sidebar.tsx",
      "frontend/components/layout/topbar.tsx",
      "frontend/components/layout/ws-provider.tsx"
    ],
    "globalCss": ["frontend/app/globals.css"],
    "lib": ["frontend/lib/store.ts", "frontend/lib/format.ts", "frontend/lib/auth.ts"]
  }
}
