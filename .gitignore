# ─────────────────────────────────────────
# 量化项目 .gitignore
# 2026-06-02
# ─────────────────────────────────────────

# ── Python ──────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── 类型检查 / 静态分析 ────────────────
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# ── 测试 / 覆盖率 ──────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# ── 虚拟环境 ────────────────────────────
venv/
env/
ENV/
.venv/
.env/
env.bak/
venv.bak/

# ── IDE / 编辑器 ────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── 数据库 / 二进制数据 (可复现,不入库) ─
data/*.db
data/*.sqlite
data/*.sqlite3
data/*.csv   # raw market data 从 MT5 broker 重拉, 不入库
data/ticks/  # tick generator 运行时生成, 不入库
!data/charts/**  # 报告/图/npy/json 入库

# ── 日志 (运行时生成) ───────────────────
logs/
*.log

# ── 临时 / 备份 / 崩溃文件 ─────────────
tmp/
*.tmp
*.bak
*.swp
*.swo
*~
*.orig
core.*
*.dmp

# ── 凭证 (绝对不能进) ──────────────────
.env
.env.local
.env.*.local
*.pem
*.key
secrets/
credentials/

# ── OS / 杂项 ───────────────────────────
.DS_Store
desktop.ini
$RECYCLE.BIN/
*.lnk

# ── 项目特定的"不固化"文件 ─────────────
# (留空, 一切由上面规则覆盖)
