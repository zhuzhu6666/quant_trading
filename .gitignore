# ─────────────────────────────────────────
# 量化项目 .gitignore — v5
# ─────────────────────────────────────────

# Python
__pycache__/
*.py[cod]
*.so
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Virtual env
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Data files (reproducible, not in repo)
data/*.db
data/*.duckdb
data/*.duckdb.wal
data/ticks/
data/dukascopy_raw/
data/feature_models/
data/ml_models/
data/browser/

# Logs
logs/
*.log

# Credentials
.env
.env.*
*.pem
*.key
secrets/
credentials/

# Hermes
.hermes/

# OS
desktop.ini
$RECYCLE.BIN/
*.lnk

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# Node / frontend (v5 removed React frontend)
node_modules/
frontend-v2/node_modules/
package-lock.json

# Build artifacts
*.egg-info/
dist/
build/
